@page "/app/settings/tracking"
@using static RatScanner.RatConfig
@inject SettingsVM SettingsVM
@inject RatScanner.TarkovTrackerDB TarkovTrackerDB
@inject LocalizationService Localizer
@implements IDisposable
<div>
    <MudGrid Class="pa-0 ma-0" Spacing="0" Style="height: 100%;">
        <MudItem xs="12">
            <div class="d-flex align-center justify-center mx-2 mb-1">
                <MudText Typo="Typo.subtitle1" Color="Color.Inherit">@Localizer["TrackingSettingsTitle"]</MudText>
            </div>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="align-center justify-center pa-2 mx-2 mb-2" Elevation="2">
                <MudCheckBox @bind-Checked="SettingsVM.ShowNonFIRNeeds" Label="@Localizer["ShowNonFirNeeds"]" Size="Size.Small" Class="pa-0 ma-0"></MudCheckBox>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="align-center justify-center pa-2 mx-2 mb-2" Elevation="2">
                <MudCheckBox @bind-Checked="SettingsVM.ShowKappaNeeds" Label="@Localizer["ShowKappaNeeds"]" Size="Size.Small" Class="pa-0 ma-0"></MudCheckBox>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="align-center justify-center pa-2 mx-2 mb-2" Elevation="2">
                <MudGrid Spacing="1">
                    <MudItem xs="12">
                        <div class="d-flex justify-center">
                            @Localizer["TarkovTrackerTitle"]
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect @bind-Value="SettingsVM.TarkovTrackerBackend" T="TarkovTrackerBackend" Label="@Localizer["BackendLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="TarkovTrackerBackend" Value="@TarkovTrackerBackend.TarkovTrackerIO">TarkovTracker.io</MudSelectItem>
                            <MudSelectItem T="TarkovTrackerBackend" Value="@TarkovTrackerBackend.TarkovTrackerORG">TarkovTracker.org</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect @bind-Value="SettingsVM.GameMode" T="RatScanner.GameMode" Label="@Localizer["GameMode"]" AnchorOrigin="Origin.BottomCenter" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            @foreach (var gameMode in GetGameModes()) {
                                <MudSelectItem Value="@gameMode">@Localizer[gameMode.ToTranslationKey()]</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="SettingsVM.TarkovTrackerToken" Validation="@(new Func<string, IEnumerable<string>>(CheckToken))" Label="@Localizer["ApiToken"]" HelperText="@TokenHelperText" InputType="@PasswordInput" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="TokenShowClick"></MudTextField>
                    </MudItem>
                    <MudItem xs="12">
                        <MudCheckBox @bind-Checked="SettingsVM.ShowTarkovTrackerTeam" Label="@Localizer["ShowTeammates"]" Size="Size.Small" Class="pa-0 ma-0"></MudCheckBox>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

@code {

    protected override void OnInitialized()
    {
        SettingsVM.PropertyChanged += PropertyChangeHandler;
    }

    private async void PropertyChangeHandler(object? sender, EventArgs e)
    {
        await InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        SettingsVM.PropertyChanged -= PropertyChangeHandler;
    }

    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    private IEnumerable<RatScanner.GameMode> GetGameModes() => Enum.GetValues(typeof(RatScanner.GameMode)) as IEnumerable<RatScanner.GameMode>;

    // TarkovTracker.io predates game modes, so its single token applies to all of them
    private bool ModeAwareBackend => SettingsVM.TarkovTrackerBackend == TarkovTrackerBackend.TarkovTrackerORG;

    private string ExpectedTokenPrefix => SettingsVM.GameMode switch {
        RatScanner.GameMode.Pve => "PVE_",
        RatScanner.GameMode.PvpSeason => "SZN_",
        _ => "PVP_",
    };

    private string TokenHelperText => ModeAwareBackend
        ? Localizer.Format("ApiTokenForMode", Localizer[SettingsVM.GameMode.ToTranslationKey()])
        : Localizer["ApiTokenSingleMode"];

    private IEnumerable<string> CheckToken(string token)
    {
        if (string.IsNullOrEmpty(token)) yield break;

        // A token of the wrong mode is accepted by the API but serves the progress of
        // the mode it was created for, so it has to be caught before it is tested
        if (ModeAwareBackend && !token.StartsWith(ExpectedTokenPrefix)) {
            yield return Localizer.Format("TokenModeMismatch", ExpectedTokenPrefix);
            yield break;
        }

        if (!TarkovTrackerDB.TestToken(token)) yield return Localizer["InvalidToken"];
    }

    void TokenShowClick()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
}
