@page "/app/settings/tracking"
@layout SettingsLayout
@using System.Globalization
@using System.Threading;
@using System.Threading.Tasks
@using MudBlazor
@using RatScanner
@using RatScanner.FetchModels.TarkovTracker
@using RatScanner.Pages.App.Components
@using RatScanner.TarkovDev.Json
@using GameMode = RatScanner.TarkovDev.Json.GameMode
@using static RatScanner.RatConfig
@inject SettingsVM SettingsVM
@inject RatScanner.TarkovTrackerDB TarkovTrackerDB
@inject LocalizationService Localizer
@inject IDialogService DialogService
@implements IDisposable

<div class="settings-split">
    <div class="settings-stack">
        <SettingsCard Title="@Localizer["ProgressSourceTitle"]" Subtitle="@Localizer["ProgressSourceDesc"]">
            <SettingsRow Label="@Localizer["ProgressSourceLabel"]" SubLabel="@Localizer["ProgressSourceHint"]">
                <MudSelect T="ProgressSource" Value="@SettingsVM.ProgressSource"
                           ValueChanged="@((ProgressSource v) => { SettingsVM.ProgressSource = v; SettingsVM.MarkDirty(); ScheduleConnectionCheck(); })"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 220px;">
                    <MudSelectItem T="ProgressSource" Value="@ProgressSource.Local">
                        @Localizer["ProgressSourceLocal"]</MudSelectItem>
                        <MudSelectItem T="ProgressSource" Value="@ProgressSource.TarkovTracker">
                            @Localizer["ProgressSourceTarkovTracker"]</MudSelectItem>
                        </MudSelect>
                    </SettingsRow>

                    <SettingsRow Label="@Localizer["ProgressResetAction"]" SubLabel="@Localizer["ProgressResetActionHint"]"
                                 Disabled="@(!HasResettableProgress)">
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(!HasResettableProgress)"
                                   StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="@ResetProgressAsync">
                            @Localizer["ProgressResetAction"]
                        </MudButton>
                    </SettingsRow>
                </SettingsCard>

                <SettingsCard Title="@Localizer["TarkovTrackerTitle"]" Subtitle="@Localizer["TarkovTrackerGroupDesc"]">
                    @if (!UsesTarkovTracker) {
                        @* Shown instead of the credentials while another storage option is selected, so
               the card explains itself rather than looking broken. *@
                        <div class="tracker-inactive">
                            <MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Localizer["TarkovTrackerInactive"]
                            </MudText>
                        </div>
                    } else {
                        @* Connection status lives with the credentials it describes, rather than
               in a section of its own. *@
                        <div class="connection-state">
                            @if (_checkingToken) {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.body1">@Localizer["ConnectionCheckingLabel"]</MudText>
                                </div>
                            } else {
                                <MudIcon Icon="@ConnectionIcon" Color="@ConnectionColor" Size="Size.Medium" />
                                <div>
                                    <MudText Typo="Typo.body1">@ConnectionLabel</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ConnectionDetail</MudText>
                                </div>
                            }
                        </div>

                        <MudDivider Class="my-2" />

                        <SettingsRow Label="@Localizer["BackendLabel"]" SubLabel="@Localizer["BackendLabelHint"]">
                            <MudSelect T="TarkovTrackerBackend" Value="@SettingsVM.TarkovTrackerBackend"
                                       ValueChanged="@((TarkovTrackerBackend v) => { SettingsVM.TarkovTrackerBackend = v; SettingsVM.MarkDirty(); ScheduleConnectionCheck(); })"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 220px;">
                                <MudSelectItem T="TarkovTrackerBackend" Value="@TarkovTrackerBackend.TarkovTrackerIO">
                                    TarkovTracker.io</MudSelectItem>
                                    <MudSelectItem T="TarkovTrackerBackend" Value="@TarkovTrackerBackend.TarkovTrackerORG">
                                        TarkovTracker.org</MudSelectItem>
                                    </MudSelect>
                                </SettingsRow>

                                <SettingsRow Label="@Localizer["ApiToken"]" SubLabel="@Localizer["ApiTokenHint"]">
                                    <MudTextField T="string" Value="@SettingsVM.TarkovTrackerToken"
                                                  ValueChanged="@((string v) => { SettingsVM.TarkovTrackerToken = v; SettingsVM.MarkDirty(); ScheduleConnectionCheck(); })"
                                                  Validation="@(new Func<string, IEnumerable<string>>(CheckToken))" InputType="@TokenInputType"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End"
                                                  AdornmentIcon="@(_showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                                  OnAdornmentClick="@(() => _showToken = !_showToken)" Immediate="true" Style="min-width: 260px;" />
                                </SettingsRow>

                                <SettingsRow Label="@Localizer["ShowTeammates"]" SubLabel="@Localizer["ShowTeammatesHint"]"
                                             Disabled="@(!IsConnected)">
                                    <MudSwitch T="bool" Checked="@SettingsVM.ShowTarkovTrackerTeam"
                                               CheckedChanged="@((bool v) => { SettingsVM.ShowTarkovTrackerTeam = v; SettingsVM.MarkDirty(); })"
                                               Color="Color.Primary" Dense="true" />
                                </SettingsRow>
                            }
                        </SettingsCard>

                        <SettingsCard Title="@Localizer["TrackingGroup"]" Subtitle="@Localizer["TrackingGroupDesc"]">
                            <SettingsSwitchRow Label="@Localizer["ShowNonFirNeeds"]" SubLabel="@Localizer["ShowNonFirNeedsHint"]"
                                               Value="@SettingsVM.ShowNonFIRNeeds"
                                               ValueChanged="@((bool v) => { SettingsVM.ShowNonFIRNeeds = v; SettingsVM.MarkDirty(); })" />

                            <SettingsSwitchRow Label="@Localizer["ShowKappaNeeds"]" SubLabel="@Localizer["ShowKappaNeedsHint"]"
                                               Value="@SettingsVM.ShowKappaNeeds"
                                               ValueChanged="@((bool v) => { SettingsVM.ShowKappaNeeds = v; SettingsVM.MarkDirty(); })" />
                        </SettingsCard>

                        @* Manual profile overrides. Only shown for the local source, since
                           the tracker reports level and faction itself and always wins.
                           One tab per game mode, because the standing a player has in
                           one mode says nothing about the others. *@
                        @if (!UsesTarkovTracker) {
                            <SettingsCard Title="@Localizer["ProfileTitle"]" Subtitle="@Localizer["ProfileDesc"]">
                                <MudTabs Centered="true" @bind-ActivePanelIndex="_profileTab">
                                    <MudDivider></MudDivider>
                                    @foreach (var mode in ProfileModes) {
                                        var entry = mode;
                                        <MudTabPanel Text="@Localizer[entry.Label]">
                                            <div class="profile-grid">
                                                <div class="profile-field">
                                                    <div class="profile-field-label">@Localizer["ProfileLevel"]</div>
                                                    <MudNumericField T="int" Value="@Profile(entry.Mode).PlayerLevel"
                                                                     ValueChanged="@((int v) => SetLevel(entry.Mode, v))" Variant="Variant.Outlined"
                                                                     Margin="Margin.Dense" HideSpinButtons="true" Min="0" Max="79"
                                                                     Style="min-width: 110px;" />
                                                </div>

                                                <div class="profile-field">
                                                    <div class="profile-field-label">@Localizer["ProfileFaction"]</div>
                                                    @* A joined button group rather than a dropdown, matching the
                                                       loyalty tier buttons on the trader cards. USEC is preselected,
                                                       so there is no third "not set" state to choose. *@
                                                    <div class="profile-faction" role="group" aria-label="@Localizer["ProfileFaction"]">
                                                        @foreach (var faction in PmcFaction.All) {
                                                            var value = faction;
                                                            <button type="button" class="profile-faction-option @FactionClass(entry.Mode, value)"
                                                                    aria-pressed="@((Profile(entry.Mode).PlayerFaction == value).ToString().ToLowerInvariant())"
                                                                    @onclick="@(() => SetFaction(entry.Mode, value))">
                                                                @Localizer[FactionLabel(value)]
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            @* <MudDivider DividerType="DividerType.Middle" Class="my-3 mx-3" /> *@

                                            @* One card per trader rather than a row per trader: the
                                                       card carries the task completion, the tier buttons and
                                                       the standing together, so a bare name and two dropdowns
                                                       cannot show how far along the player actually is. *@
                                            <div class="profile-traders">
                                                @foreach (var trader in Traders) {
                                                    var id = trader.Id;
                                                    var standing = GetStanding(entry.Mode, id);
                                                    var tasks = TraderTaskProgress(entry.Mode, id);
                                                    <TraderStandingCard Trader="@trader" Level="@standing.Level" Reputation="@standing.Reputation"
                                                                        CompleteTasks="@tasks.Complete" TotalTasks="@tasks.Total"
                                                                        LevelChanged="@((int v) => SetLevel(entry.Mode, id, v))"
                                                                        ReputationChanged="@((double? v) => SetReputation(entry.Mode, id, v))" />
                                                }
                                            </div>

                                            <div class="profile-actions">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="@(() => ResetProfile(entry.Mode))">
                                                    @Localizer["ProfileResetAction"]
                                                </MudButton>
                                            </div>
                                        </MudTabPanel>
                                    }
                                </MudTabs>
                            </SettingsCard>
                        }

                        <SettingsCard Title="@Localizer["LogTrackingTitle"]" Subtitle="@Localizer["LogTrackingDesc"]">
                            <SettingsSwitchRow Label="@Localizer["LogTrackingEnable"]" SubLabel="@Localizer["LogTrackingEnableHint"]"
                                               Value="@SettingsVM.EnableLogTracking"
                                               ValueChanged="@((bool v) => { SettingsVM.EnableLogTracking = v; SettingsVM.MarkDirty(); })" />

                            <SettingsSwitchRow Label="@Localizer["LogTrackingQuests"]" SubLabel="@Localizer["LogTrackingQuestsHint"]"
                                               Value="@SettingsVM.LogTrackQuests"
                                               ValueChanged="@((bool v) => { SettingsVM.LogTrackQuests = v; SettingsVM.MarkDirty(); })"
                                               Disabled="@(!SettingsVM.EnableLogTracking)" />

                            <SettingsSwitchRow Label="@Localizer["LogTrackingRaid"]" SubLabel="@Localizer["LogTrackingRaidHint"]"
                                               Value="@SettingsVM.LogTrackRaidLifecycle"
                                               ValueChanged="@((bool v) => { SettingsVM.LogTrackRaidLifecycle = v; SettingsVM.MarkDirty(); })"
                                               Disabled="@(!SettingsVM.EnableLogTracking)" />

                            <SettingsSwitchRow Label="@Localizer["LogTrackingMode"]" SubLabel="@Localizer["LogTrackingModeHint"]"
                                               Value="@SettingsVM.LogTrackGameMode"
                                               ValueChanged="@((bool v) => { SettingsVM.LogTrackGameMode = v; SettingsVM.MarkDirty(); })"
                                               Disabled="@(!SettingsVM.EnableLogTracking)" />

                            <SettingsSwitchRow Label="@Localizer["LogTrackingPosition"]"
                                               SubLabel="@Localizer["LogTrackingPositionHint"]" Value="@SettingsVM.LogTrackPlayerPosition"
                                               ValueChanged="@((bool v) => { SettingsVM.LogTrackPlayerPosition = v; SettingsVM.MarkDirty(); })"
                                               Disabled="@(!SettingsVM.EnableLogTracking)" />

                            <SettingsRow Label="@Localizer["LogTrackingPath"]" SubLabel="@Localizer["LogTrackingPathHint"]"
                                         Disabled="@(!SettingsVM.EnableLogTracking)">
                                <MudTextField T="string" Value="@SettingsVM.LogPathOverride"
                                              ValueChanged="@((string v) => { SettingsVM.LogPathOverride = v; SettingsVM.MarkDirty(); })"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Immediate="true"
                                              Style="min-width: 320px;" />
                            </SettingsRow>

                            <SettingsRow Label="@Localizer["LogTrackingPositionMap"]"
                                         SubLabel="@Localizer["LogTrackingPositionMapHint"]" Disabled="@(!SettingsVM.EnableLogTracking)">
                                <MudSelect T="string" Value="@SettingsVM.PositionMapFallback"
                                           ValueChanged="@((string v) => { SettingsVM.PositionMapFallback = v; SettingsVM.MarkDirty(); })"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 220px;">
                                    @foreach (var map in AvailableMaps) {
                                        <MudSelectItem T="string" Value="@map.Id">@map.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </SettingsRow>

                            @* Shown only once log tracking is on, so a failed detection
                               is visible here instead of silently doing nothing. *@
                            @if (SettingsVM.EnableLogTracking) {
                                <MudText Typo="Typo.caption" Color="@(_logsResolved ? Color.Secondary : Color.Warning)" Class="ml-4 mb-2">
                                    @Localizer["LogTrackingStatus"]:
                                    <span>@(_logsResolved ? _logsFolder : Localizer["LogTrackingStatusMissing"])</span>
                                    @if (_logsResolved) {
                                        <span> (@Localizer["LogTrackingStatusFound"])</span>
                                    }
                                </MudText>
                            }

                            @* Reading past logs is a manual action: it rewrites quest
                               progress, so it never runs on its own. *@
                            <SettingsRow Label="@Localizer["LogTrackingHistory"]" SubLabel="@Localizer["LogTrackingHistoryHint"]"
                                         Disabled="@(!SettingsVM.EnableLogTracking || !SettingsVM.LogTrackQuests || _replaying)">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_replaying"
                                           OnClick="@ReadPastLogsAsync" StartIcon="@Icons.Material.Filled.History">
                                    @(_replaying ? Localizer["LogTrackingHistoryReading"] : Localizer["LogTrackingHistoryAction"])
                                </MudButton>
                            </SettingsRow>
                        </SettingsCard>
                    </div>
                </div>

                <style>
                    /* Level and faction sit side by side rather than as two full-width
                                                                                                                                                                                                                                                                                                       SettingsRows, which pushed the trader list a long way down.

                                                                                                                                                                                                                                                                                                       The 16px horizontal inset is the card's own content inset, matching
                                                                                                                                                                                                                                                                                                       .settings-row and .settings-card-title, so every settings section
                                                                                                                                                                                                                                                                                                       starts its text at the same x. It was 4px, which left this section
                                                                                                                                                                                                                                                                                                       visibly hugging the card edge next to the sections around it. */
                    .profile-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                        gap: 16px;
                        padding: 8px 16px 0;
                        margin-bottom: 8px;
                    }

                    .profile-field {
                        display: flex;
                        flex-direction: column;
                        gap: 4px;
                        min-width: 0;
                    }

                    .profile-field-label {
                        font-size: 14px;
                        line-height: 1.35;
                    }

                    /* Faction as a joined button group, deliberately matching
                                                                                                                                                                                                                                                                                                       the loyalty tier buttons on the trader cards so the two
                                                                                                                                                                                                                                                                                                       controls read as the same kind of choice. */
                    .profile-faction {
                        display: flex;
                        width: 100%;
                        align-self: flex-start;
                        min-width: 0;
                        overflow: hidden;
                        border: 1px solid var(--mud-palette-lines-default, rgba(255, 255, 255, 0.12));
                        border-radius: 6px;
                    }

                    .profile-faction-option {
                        flex: 1 1 0;
                        min-width: 0;
                        min-height: 40px;
                        padding: 6px 16px;
                        border: 0;
                        border-left: 1px solid var(--mud-palette-lines-default, rgba(255, 255, 255, 0.12));
                        background: transparent;
                        color: var(--mud-palette-text-secondary, rgba(255, 255, 255, 0.6));
                        font: inherit;
                        font-size: 13px;
                        font-weight: 600;
                        cursor: pointer;
                        transition: background-color 120ms ease-in-out, color 120ms ease-in-out;
                    }

                    .profile-faction-option:first-child {
                        border-left: 0;
                    }

                    .profile-faction-option:hover {
                        background: var(--mud-palette-action-default-hover, rgba(255, 255, 255, 0.06));
                        color: var(--mud-palette-text-primary, rgba(255, 255, 255, 0.95));
                    }

                    .profile-faction-option.profile-faction-option-active {
                        background: var(--mud-palette-primary, #594AE2);
                        color: #fff;
                    }

                    .profile-faction-option:focus-visible {
                        outline: 2px solid var(--mud-palette-primary, #594AE2);
                        outline-offset: -2px;
                    }

                    /* Two cards per row, so the eight traders take four rows
                                                                                                                                                                                                                                                                                                       instead of eight. A fixed count rather than auto-fill because
                                                                                                                                                                                                                                                                                                       auto-fill would reach three on a wide window and the cards are
                                                                                                                                                                                                                                                                                                       narrow enough already: each one has to hold a four-button group
                                                                                                                                                                                                                                                                                                       AND the reputation box side by side. */
                    .profile-traders {
                        display: grid;
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                        gap: 10px;
                        padding: 0 16px;
                    }

                    /* Below this the two cards cannot hold the tier buttons and the
                                                                                                                                                                                                                                                                                                       reputation box side by side, so fall back to one. */
                    @@media (max-width: 540px) {
                        .profile-traders {
                            grid-template-columns: minmax(0, 1fr);
                        }
                    }

                    .profile-actions {
                        display: flex;
                        justify-content: flex-end;
                        padding: 12px 16px 0;
                    }
                </style>

@code {
    private const int DebounceMs = 600;

    private bool _showToken;
    private bool _checkingToken;
    private bool _isConnected;
    private string _checkedToken = "";
    private RatConfig.TarkovTrackerBackend _checkedBackend;
    private Timer? _debounce;

    private InputType TokenInputType => _showToken ? InputType.Text : InputType.Password;

    private bool IsConnected => _isConnected;

    /// <summary>
    /// Whether the saved token has been through a check that finished. Until it has,
    /// its validity is unknown rather than false.
    /// </summary>
    private bool TokenChecked => !string.IsNullOrEmpty(_checkedToken)
        && _checkedToken == (SettingsVM.TarkovTrackerToken?.Trim() ?? "")
        && _checkedBackend == SettingsVM.TarkovTrackerBackend;

    /// <summary>
    /// Whether TarkovTracker is the selected source. Its card shows a prompt instead of
    /// the credentials while this is false.
    /// </summary>
    private bool UsesTarkovTracker => SettingsVM.ProgressSource == ProgressSource.TarkovTracker;
    private bool HasToken => !string.IsNullOrWhiteSpace(SettingsVM.TarkovTrackerToken);

    /// <summary>Maps offered as the position-marker fallback, sorted by name.</summary>
    private List<RatScanner.TarkovDev.Json.Map> AvailableMaps { get; set; } = [];

    /// <summary>
    /// Traders offered a standing card. Narrowed to the eight real ones by
    /// <see cref="StandardTraders"/>; resolved from the tarkov.dev catalogue so
    /// the user picks by name rather than by id.
    /// </summary>
    private List<Trader> Traders { get; set; } = [];

    private static readonly (GameMode Mode, string Label)[] ProfileModes = [
        (GameMode.Regular, "GameModeRegular"),
        (GameMode.Pve, "GameModePve"),
        (GameMode.PvpSeason, "GameModePvpSeason"),
    ];

    /// <summary>
    /// Which mode's profile tab is open. Starts on the mode actually in play, so
    /// the values on screen are the ones the quest gates are reading. Set in
    /// OnInitialized because SettingsVM is injected and cannot be read from a
    /// field initializer.
    /// </summary>
    private int _profileTab;

    private ManualTraderStanding GetStanding(GameMode mode, string traderId) {
        var profile = Profile(mode);
        if (!profile.ManualTraders.TryGetValue(traderId, out var standing)) {
            standing = new ManualTraderStanding();
            profile.ManualTraders[traderId] = standing;
        }

        return standing;
    }

    /// <summary>
    /// The staged profile for a mode. Always returns an instance so the controls
    /// have something to bind to even for a mode with nothing entered yet.
    /// </summary>
    private ManualProfile Profile(GameMode mode) {
        if (!SettingsVM.ManualProfiles.TryGetValue(mode, out var profile)) {
            profile = new ManualProfile();
            SettingsVM.ManualProfiles[mode] = profile;
        }

        return profile;
    }

    private void SetLevel(GameMode mode, int level) {
        Profile(mode).PlayerLevel = Math.Clamp(level, 0, 79);
        SettingsVM.MarkDirty();
    }

    private void SetFaction(GameMode mode, string? faction) {
        Profile(mode).PlayerFaction = faction ?? "";
        SettingsVM.MarkDirty();
    }

    /// <summary>
    /// The button class for a faction, marking the one currently held.
    /// </summary>
    /// <remarks>
    /// Anything other than BEAR reads as USEC, so a mode whose faction was never
    /// entered still shows USEC selected rather than leaving the group with
    /// neither option pressed.
    /// </remarks>
    private string FactionClass(GameMode mode, string faction) =>
        CurrentFaction(mode) == faction ? "profile-faction-option-active" : "";

    /// <summary>
    /// The faction the mode is set to, defaulting to USEC.
    ///
    /// USEC is the default rather than a third "not set" option because the
    /// buttons have no empty state to click back into, and leaving a group with
    /// nothing selected reads as a control that failed to load.
    /// </summary>
    private string CurrentFaction(GameMode mode) {
        var faction = Profile(mode).PlayerFaction;
        return string.IsNullOrEmpty(faction) ? PmcFaction.Usec : faction;
    }

    /// <summary>
    /// The i18n key for a faction's button, since the stored value is the
    /// bare upper-case name the gates compare on.
    /// </summary>
    private static string FactionLabel(string faction) =>
        faction == PmcFaction.Bear ? "ProfileFactionBear" : "ProfileFactionUsec";

    private void SetLevel(GameMode mode, string traderId, int level) {
        GetStanding(mode, traderId).Level = Math.Clamp(level, 0, 4);
        SettingsVM.MarkDirty();
    }

    /// <summary>
    /// Records a trader's reported standing. The value is kept as typed rather
    /// than rounded, because tarkov.dev's own loyalty thresholds are fractional
    /// (0.5, 2.5, 6.5) and rounding here would put a player at 6.5 on a level
    /// that really needs 6.5 somewhere the gates read as short.
    /// </summary>
    private void SetReputation(GameMode mode, string traderId, double? value) {
        GetStanding(mode, traderId).Reputation = value;
        SettingsVM.MarkDirty();
    }

    /// <summary>
    /// How many of a trader's tasks are done in the mode whose tab is open,
    /// out of all the tasks they hand out. Cached per mode, since the same
    /// counts are re-read on every repaint of the tab.
    ///
    /// Counted per mode because progress is kept per mode: a card must report
    /// the tab it sits on, not the mode the game happens to be in.
    /// </summary>
    private (int Complete, int Total) TraderTaskProgress(GameMode mode, string traderId) {
        var key = (mode, traderId);
        if (_traderTaskCounts.TryGetValue(key, out var cached)) return cached;

        (int Complete, int Total) counts = (0, 0);
        try {
            counts = RatScanner.TaskExtensions.GetTraderTaskProgress(TraderTasks(traderId), ProgressFor(mode));
        } catch (Exception e) {
            Logger.LogWarning($"Could not count completed tasks for trader {traderId}: {e.Message}");
        }

        _traderTaskCounts[key] = counts;
        return counts;
    }

    /// <summary>
    /// Recorded progress for one mode. Read through the store per mode, since
    /// its single-entry cache only ever serves the mode actually in play and the
    /// tabs show the others too.
    /// </summary>
    private UserProgress ProgressFor(GameMode mode) {
        var store = RatScannerMain.Instance?.LocalProgress;
        if (store is null) return Item.SelfProgress;
        return store.GetProgress(mode);
    }

    /// <summary>
    /// A trader's tasks, grouped once and cached, so the per-card completion
    /// counts are a lookup rather than a rescan of the whole catalogue.
    /// </summary>
    private IReadOnlyList<TarkovTask> TraderTasks(string traderId) {
        if (!_traderTasks.TryGetValue(traderId, out var tasks)) {
            tasks = [];
            try {
                tasks = [.. TarkovDevAPI.GetTasks().Where(t =>
                    string.Equals(t.TraderId, traderId, StringComparison.Ordinal))];
            } catch (Exception e) {
                Logger.LogWarning($"Could not group tasks by trader: {e.Message}");
            }

            _traderTasks[traderId] = tasks;
        }

        return tasks;
    }

    private readonly Dictionary<string, IReadOnlyList<TarkovTask>> _traderTasks = new(StringComparer.Ordinal);
    private readonly Dictionary<(GameMode Mode, string TraderId), (int Complete, int Total)> _traderTaskCounts = [];

    /// <summary>
    /// Drops the cached completion counts, which go stale as soon as a task is
    /// ticked, a counter is stepped or the mode changes. The task grouping itself
    /// is left alone: it comes from the catalogue, which does not change while
    /// the page is open.
    /// </summary>
    private void InvalidateTaskCounts() => _traderTaskCounts.Clear();

    /// <summary>
    /// Clears one mode's profile, leaving the other tabs alone.
    /// </summary>
    private void ResetProfile(GameMode mode) {
        var profile = Profile(mode);
        profile.PlayerLevel = 0;
        profile.PlayerFaction = "";
        profile.ManualTraders.Clear();
        SettingsVM.MarkDirty();
    }
    private static readonly (GameMode Mode, string Label)[] ProgressModes = [
        (GameMode.Regular, "GameModeRegular"),
        (GameMode.Pve, "GameModePve"),
        (GameMode.PvpSeason, "GameModePvpSeason"),
    ];

    private bool HasResettableProgress {
        get {
            var store = RatScannerMain.Instance?.LocalProgress;
            if (store == null) return false;
            return ProgressModes.Any(m => store.GetCounts(m.Mode).HasRecorded);
        }
    }

    /// <summary>
    /// Opens the picker, then erases whatever came back. The dialog decides which
    /// modes are involved; nothing is erased until it returns a choice.
    /// </summary>
    private async Task ResetProgressAsync() {
        var store = RatScannerMain.Instance?.LocalProgress;
        if (store == null) return;

        var entries = ProgressModes.Select(m => {
            var counts = store.GetCounts(m.Mode);
            return new ProgressResetDialog.ModeEntry(m.Mode, m.Label, counts.Objectives, counts.Tasks);
        }).ToList();

        if (!entries.Any(e => e.HasRecorded)) return;

        var dialog = await DialogService.ShowAsync<ProgressResetDialog>(
            Localizer["ProgressResetAction"],
            options: new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true },
            parameters: new DialogParameters {
                { nameof(ProgressResetDialog.Modes), entries },
            });

        // In MudBlazor 6 the typed result comes off the reference, not the call.
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        if (result.Data is not GameMode[] modes || modes.Length == 0) return;

        store.ResetProgress(modes);
        StateHasChanged();
    }

    /// <summary>Resolved logs folder, so a failed detection is visible rather than silent.</summary>
    private string _logsFolder = "";
    private bool _logsResolved;

    /// <summary>True while past logs are being read, so the button cannot be pressed twice.</summary>
    private bool _replaying;

    /// <summary>
    /// Offers the past sessions and replays the one picked. Reading rewrites quest
    /// progress, so the choice is always made by hand and never happens on startup.
    /// </summary>
    private async Task ReadPastLogsAsync() {
        if (_replaying) return;

        _replaying = true;
        try {
            // Listing walks the disk, so it stays off the UI thread.
            var sessions = await Task.Run(RatScannerMain.Instance.PastLogSessions);
            var options = sessions.ToList();

            var dialog = await DialogService.ShowAsync<LogSessionPickerDialog>(
                Localizer["LogTrackingHistory"],
                options: new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true },
                parameters: new DialogParameters {
                    { nameof(LogSessionPickerDialog.Sessions), options },
                    { nameof(LogSessionPickerDialog.LogsFolder), _logsFolder },
                });

            // In MudBlazor 6 the typed result comes off the reference, not the
            // call itself.
            var result = await dialog.Result;
            if (result is null || result.Canceled) return;
            if (result.Data is not LogSessionPickerDialog.Selection selection) return;

            var session = selection.Session;
            await Task.Run(() => RatScannerMain.Instance.ReplayPastSession(session, includeNewer: true));

            await DialogService.ShowMessageBox(
                Localizer["LogTrackingTitle"],
                LocalizationService.Format("LogTrackingHistoryDoneFrom", session.Label, selection.Recovered));
        } catch (Exception e) {
            Logger.LogWarning($"Could not read past EFT logs: {e.Message}");
            await DialogService.ShowMessageBox(
                Localizer["LogTrackingTitle"],
                LocalizationService.Format("LogTrackingHistoryFailed", e.Message));
        } finally {
            _replaying = false;
        }
    }

    private void ResolveLogsFolder() {
        try {
            _logsFolder = EftLogs.LogsFolder;
            _logsResolved = !string.IsNullOrEmpty(_logsFolder);
        } catch (Exception e) {
            _logsFolder = "";
            _logsResolved = false;
            Logger.LogWarning($"Could not resolve the EFT logs folder: {e.Message}");
        }
    }

    private string ConnectionLabel => _isConnected
        ? Localizer["ConnectionOkLabel"]
        : HasToken
            ? TokenChecked ? Localizer["ConnectionInvalidLabel"] : Localizer["ConnectionCheckingLabel"]
            : Localizer["ConnectionNoneLabel"];

    private string ConnectionDetail => _isConnected
        ? Localizer["ConnectionOkDetail"]
        : HasToken
            ? TokenChecked ? Localizer["ConnectionInvalidDetail"] : Localizer["ConnectionPendingDetail"]
            : Localizer["ConnectionNoneDetail"];

    private string ConnectionIcon => _isConnected
        ? Icons.Material.Filled.CheckCircle
        : HasToken
            ? TokenChecked ? Icons.Material.Filled.Error : Icons.Material.Filled.CloudQueue
            : Icons.Material.Filled.CloudOff;

    private Color ConnectionColor => _isConnected
        ? Color.Success
        : HasToken
            ? TokenChecked ? Color.Error : Color.Default
            : Color.Default;

    /// <summary>
    /// Validates the token once per token/backend pair, after typing settles.
    /// </summary>
    /// <remarks>
    /// TestToken performs a blocking HTTP request, so it must not run during
    /// render or on every keystroke. Typing restarts a short debounce timer;
    /// each request supersedes the previous one, so a slow reply for an older
    /// token can never overwrite the result for the current one.
    /// </remarks>
    private void ScheduleConnectionCheck() {
        _debounce?.Dispose();
        _debounce = new Timer(_ => InvokeAsync(RunConnectionCheckAsync), null, DebounceMs, Timeout.Infinite);
    }

    private async Task RunConnectionCheckAsync() {
        string token = SettingsVM.TarkovTrackerToken?.Trim() ?? "";
        var backend = SettingsVM.TarkovTrackerBackend;

        // Nothing is checked while another source is selected, since the credentials are
        // not on screen. Clears the verdict so re-selecting re-checks.
        if (!UsesTarkovTracker) {
            await InvokeAsync(() => {
                _isConnected = false;
                _checkingToken = false;
                _checkedToken = "";
                StateHasChanged();
            });
            return;
        }

        if (string.IsNullOrEmpty(token)) {
            await InvokeAsync(() => {
                _isConnected = false;
                _checkedToken = token;
                _checkedBackend = backend;
                _checkingToken = false;
                StateHasChanged();
            });
            return;
        }

        // Reuse a verdict from a previous visit instead of asking the server
        // again. Both outcomes are cached, so a known-bad token is not re-tested
        // on every visit either. Only a changed token or backend reaches the network.
        var cached = TarkovTrackerDB.GetCachedValidation(token, backend);

        if (cached.HasValue) {
            await InvokeAsync(() => {
                _isConnected = cached.Value;
                _checkedToken = token;
                _checkedBackend = backend;
                _checkingToken = false;
                StateHasChanged();
            });
            return;
        }

        if (token == _checkedToken && backend == _checkedBackend) return;

        _checkingToken = true;
        await InvokeAsync(StateHasChanged);

        bool result = await Task.Run(() => TarkovTrackerDB.TestToken(token));

        TarkovTrackerDB.CacheValidation(token, backend, result);

        // Discard the answer if the token changed while the request was in flight.
        if (token != (SettingsVM.TarkovTrackerToken?.Trim() ?? "")) {
            ScheduleConnectionCheck();
            return;
        }

        await InvokeAsync(() => {
            _isConnected = result;
            _checkedToken = token;
            _checkedBackend = backend;
            _checkingToken = false;
            StateHasChanged();
        });
    }

    private IEnumerable<string> CheckToken(string token) {
        if (string.IsNullOrEmpty(token)) yield break;

        // Only report a verdict for a token we have actually finished checking;
        // while the user is still typing, or a check is in flight, stay quiet
        // rather than flagging an unfinished value as invalid.
        if (_checkingToken || token != _checkedToken) yield break;

        if (!_isConnected) yield return Localizer["InvalidToken"];
    }

    protected override async Task OnInitializedAsync() {
        SettingsVM.PropertyChanged += PropertyChangeHandler;
        LocalProgressStore.Changed += ProgressChangeHandler;

        ResolveLogsFolder();

        try {
            AvailableMaps = [.. TarkovDevAPI.GetMaps().OrderBy(m => m.Name)];
        } catch (Exception e) {
            Logger.LogWarning($"Could not load maps for the position map picker: {e.Message}");
        }

        try {
            // Only the eight real traders: the endpoint also returns story NPCs
            // and raider contacts, which have no loyalty to set.
            Traders = StandardTraders.Resolve(TarkovDevAPI.GetTraders());
        } catch (Exception e) {
            Logger.LogWarning($"Could not load traders for the standing overrides: {e.Message}");
        }

        // Open on the mode actually in play, so the profile on screen is the one
        // the quest gates are reading rather than an unrelated one.
        _profileTab = 0;
        for (var i = 0; i < ProfileModes.Length; i++) {
            if (ProfileModes[i].Mode == SettingsVM.GameMode) {
                _profileTab = i;
                break;
            }
        }

        await RunConnectionCheckAsync();
    }

    private void PropertyChangeHandler(object? sender, System.ComponentModel.PropertyChangedEventArgs e) {
        ResolveLogsFolder();
        _ = InvokeAsync(() => StateHasChanged());
    }

    /// <summary>
    /// Repaints the cards when recorded progress changes, so a task ticked
    /// elsewhere in the app is reflected here without reopening the page. The
    /// cached counts are dropped first, since they are what went stale.
    /// </summary>
    private void ProgressChangeHandler() {
        InvalidateTaskCounts();
        _ = InvokeAsync(() => StateHasChanged());
    }

    public void Dispose() {
        SettingsVM.PropertyChanged -= PropertyChangeHandler;
        LocalProgressStore.Changed -= ProgressChangeHandler;
        _debounce?.Dispose();
    }
}

