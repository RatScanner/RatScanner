@page "/app/settings/hotkeys"
@layout SettingsLayout
@using RatScanner
@using RatScanner.Components
@inject SettingsVM SettingsVM
@inject LocalizationService Localizer
@implements IDisposable

<div class="settings-stack">
    <SettingsCard Title="@Localizer["ScanHotkeysGroup"]" Subtitle="@Localizer["ScanHotkeysGroupDesc"]"
                  Footer="@Localizer["HotkeysFooter"]">
        <SettingsRow Label="@Localizer["NameScanHotkey"]" SubLabel="@Localizer["NameScanHotkeyHint"]"
                     Disabled="@(!SettingsVM.EnableNameScan)">
            <HotkeySelector Hotkey="@SettingsVM.NameScanHotkey" @key="SettingsVM.NameScanHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["IconScanHotkey"]" SubLabel="@Localizer["IconScanHotkeyHint"]"
                     Disabled="@(!SettingsVM.EnableIconScan)">
            <HotkeySelector Hotkey="@SettingsVM.IconScanHotkey" @key="SettingsVM.IconScanHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>
    </SettingsCard>

    <SettingsCard Title="@Localizer["OverlayHotkeysGroup"]" Subtitle="@Localizer["OverlayHotkeysGroupDesc"]">
        <SettingsRow Label="@Localizer["OpenSearchOverlay"]" SubLabel="@Localizer["OpenSearchOverlayHint"]"
                     Disabled="@(!SettingsVM.EnableIneractableOverlay)">
            <HotkeySelector Hotkey="@SettingsVM.InteractableOverlayHotkey" @key="SettingsVM.InteractableOverlayHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["CloseSearchOverlay"]" SubLabel="@Localizer["CloseSearchOverlayHint"]"
                     Disabled="@(!SettingsVM.EnableIneractableOverlay)">
            <HotkeySelector Hotkey="@SettingsVM.CloseOverlayHotkey" @key="SettingsVM.CloseOverlayHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>
    </SettingsCard>

    <SettingsCard Title="@Localizer["AppHotkeysGroup"]" Subtitle="@Localizer["AppHotkeysGroupDesc"]">
        <SettingsRow Label="@Localizer["OpenWiki"]" SubLabel="@Localizer["OpenWikiHint"]">
            <HotkeySelector Hotkey="@SettingsVM.OpenWikiHotkey" @key="SettingsVM.OpenWikiHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["OpenTarkovDev"]" SubLabel="@Localizer["OpenTarkovDevHint"]">
            <HotkeySelector Hotkey="@SettingsVM.OpenTarkovDevHotkey" @key="SettingsVM.OpenTarkovDevHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>
    </SettingsCard>
</div>

@code {
    protected override void OnInitialized()
    {
        SettingsVM.PropertyChanged += PropertyChangeHandler;
    }

    private async void PropertyChangeHandler(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        await InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        SettingsVM.PropertyChanged -= PropertyChangeHandler;
    }
}
