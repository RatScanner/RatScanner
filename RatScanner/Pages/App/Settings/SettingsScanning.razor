@page "/app/settings/scanning"
@layout SettingsLayout
@using RatScanner
@using RatScanner.Components
@using System.Linq
@inject SettingsVM SettingsVM
@inject LocalizationService Localizer
@implements IDisposable

<div class="settings-stack">
    <SettingsCard Title="@Localizer["NameScanGroup"]" Subtitle="@Localizer["NameScanGroupDesc"]">
        <SettingsRow Label="@Localizer["EnableNameScan"]" SubLabel="@Localizer["EnableNameScanHint"]">
            <MudSwitch T="bool" Checked="@SettingsVM.EnableNameScan"
                       CheckedChanged="@((bool v) => { SettingsVM.EnableNameScan = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["NameScanHotkey"]" SubLabel="@Localizer["NameScanHotkeyHint"]"
                     Disabled="@(!SettingsVM.EnableNameScan)">
            <HotkeySelector Hotkey="@SettingsVM.NameScanHotkey" @key="SettingsVM.NameScanHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["AutomaticScanning"]" SubLabel="@Localizer["AutomaticScanningHint"]"
                     Disabled="@(!SettingsVM.EnableNameScan)">
            <MudSwitch T="bool" Checked="@SettingsVM.EnableAutoNameScan"
                       CheckedChanged="@((bool v) => { SettingsVM.EnableAutoNameScan = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["NameScanLanguage"]" SubLabel="@Localizer["NameScanLanguageHint"]"
                     Disabled="@(!SettingsVM.EnableNameScan)">
            <MudSelect T="int" Value="@SettingsVM.NameScanLanguage"
                       ValueChanged="@((int v) => { SettingsVM.NameScanLanguage = v; SettingsVM.MarkDirty(); })"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 220px;">
                @foreach (var language in GetLanguages()) {
                    <MudSelectItem T="int" Value="@language.ordinal">@language.name</MudSelectItem>
                }
            </MudSelect>
        </SettingsRow>
    </SettingsCard>

    <SettingsCard Title="@Localizer["IconScanGroup"]" Subtitle="@Localizer["IconScanGroupDesc"]">
        <SettingsRow Label="@Localizer["EnableIconScan"]" SubLabel="@Localizer["EnableIconScanHint"]">
            <MudSwitch T="bool" Checked="@SettingsVM.EnableIconScan"
                       CheckedChanged="@((bool v) => { SettingsVM.EnableIconScan = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["IconScanHotkey"]" SubLabel="@Localizer["IconScanHotkeyHint"]"
                     Disabled="@(!SettingsVM.EnableIconScan)">
            <HotkeySelector Hotkey="@SettingsVM.IconScanHotkey" @key="SettingsVM.IconScanHotkey"
                            OnHotkeyChanged="@(() => SettingsVM.MarkDirty())" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["ScanRotatedIcons"]" SubLabel="@Localizer["ScanRotatedIconsHint"]"
                     Disabled="@(!SettingsVM.EnableIconScan)">
            <MudSwitch T="bool" Checked="@SettingsVM.ScanRotatedIcons"
                       CheckedChanged="@((bool v) => { SettingsVM.ScanRotatedIcons = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>

        <SettingsRow Label="@Localizer["UseCachedIcons"]" SubLabel="@Localizer["UseCachedIconsHint"]"
                     Disabled="@(!SettingsVM.EnableIconScan)">
            <MudSwitch T="bool" Checked="@SettingsVM.UseCachedIcons"
                       CheckedChanged="@((bool v) => { SettingsVM.UseCachedIcons = v; SettingsVM.MarkDirty(); })"
                       Color="Color.Primary" Dense="true" />
        </SettingsRow>
    </SettingsCard>
</div>

@code {
    private static readonly (string name, int ordinal)[] Languages = BuildLanguages();

    private static (string name, int ordinal)[] BuildLanguages() {
        var values = Enum.GetValues(typeof(RatStash.Language)).Cast<RatStash.Language>();
        return values.Select(language => (name: language.ToString(), ordinal: (int)language))
                     .OrderBy(language => language.name)
                     .ToArray();
    }

    private IEnumerable<(string name, int ordinal)> GetLanguages() => Languages;

    protected override void OnInitialized() {
        SettingsVM.PropertyChanged += PropertyChangeHandler;
    }

    private async void PropertyChangeHandler(object? sender, System.ComponentModel.PropertyChangedEventArgs e) {
        await InvokeAsync(() => StateHasChanged());
    }

    public void Dispose() {
        SettingsVM.PropertyChanged -= PropertyChangeHandler;
    }
}
