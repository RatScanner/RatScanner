@page "/"
@page "/app"
@using RatScanner.Pages.InteractableOverlay.Components
@using RatScanner.Scan
@using RatScanner.TarkovDev.Json
@using RatScanner.Pages.App.Components
@using RatScanner.Pages.InteractableOverlay.Services
@using RatScanner.TarkovDev.Json
@using TJsonItem = RatScanner.TarkovDev.Json.Item
@using System.Diagnostics
@using Task = System.Threading.Tasks.Task;
@using RatScanner.TarkovDev.Json;
@using SearchResult = RatScanner.Pages.InteractableOverlay.Services.SearchResult
@inject MenuVM MenuVM
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject LocalizationService Localizer
@implements IDisposable

<div class="page">
    <!-- Main Content -->
    <MudStack Spacing="2" Class="pa-2 main-content">
        <!-- Search Box -->
        @* flex:none matters here. MudItem renders flex-basis:100% from xs="12",
           which in this now-definite-height column would size the search box to
           the full height and shove everything else off the bottom. *@
        <MudItem xs="12" Class="search-box">
            <MudPaper Class="d-flex flex-column pa-1" Elevation="2">
                <MudPaper>
                    <MudTextField @ref="_searchTextField" T="string" Variant="Variant.Outlined"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="20"
                                  OnDebounceIntervalElapsed="ExecuteSearch" @bind-Value="@_searchText">
                    </MudTextField>
                </MudPaper>

                <MudStack Spacing="2" Class="py-2 overflow-visible" Style="max-height:50vh; overflow-y: auto;">
                    @for (int _i = 0; _i < _searchResults.Count(); _i++) {
                        int i = _i;
                        SearchResult searchResult = _searchResults.ElementAt(i);
                        
                        @if (searchResult.Data is Item item) {
                            <ItemSearchResult Item="@item" Detail="DetailLevel.SearchRow" OnClick="@(() => SelectResult(i))" />
                        } else if (searchResult.Data is TarkovTask task) {
                            <TaskSearchResult Task="@task" Detail="DetailLevel.SearchRow" OnClick="@(() => SelectResult(i))" />
                        } else if (searchResult.Data is Map map) {
                            <MapSearchResult Map="@map" Detail="DetailLevel.SearchRow" OnMapClick="@(() => SelectResult(i))" />
                        }
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <!-- Selection history -->
        @if (SelectedResults.Count > 1) {
            @* The queue runs oldest first, so it is reversed to put the most
               recent pick on the left. Anything past the row's width is clipped
               rather than scrolled, since the rest is only reachable by picking
               something new. *@
            <MudItem xs="12" Class="flex-none">
                <MudPaper Class="pa-1" Elevation="1">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="history-row">
                        @foreach (var history in SelectedResults.Reverse()) {
                            var entry = history;
                            var activeClass = ReferenceEquals(entry, Selected) ? "history-entry-active" : "";
                            <MudPaper Class="@($"history-entry px-2 py-1 {activeClass}")"
                                      @onclick="@(() => SelectHistory(entry))">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @switch (entry.Data) {
                                        case Item histItem:
                                            <MudImage Src="@histItem.BaseImageLink" Class="history-thumb" />
                                            <MudText Typo="Typo.caption" Class="history-label">@histItem.ShortName</MudText>
                                            break;
                                        case Map histMap:
                                            <MudImage Src="@MapBannerUrl(histMap)" Class="history-thumb" />
                                            <MudText Typo="Typo.caption" Class="history-label">@histMap.Name</MudText>
                                            break;
                                        case TarkovTask histTask:
                                            <MudImage Src="@histTask.TaskImageLink" Class="history-thumb" />
                                            <MudText Typo="Typo.caption" Class="history-label">@histTask.Name</MudText>
                                            break;
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

        <!-- Last Scanned Item -->
        @if (Selected?.Data is Item displayed) {
            <ItemSearchResult Item="@displayed" Detail="DetailLevel.Full" />
            <ItemQuestTable Item="@displayed" />
        } else if (Selected?.Data is TarkovTask selectedTask) {
            @* Wired so objectives that name a place get a map button. Objectives
               without location data hide it themselves. *@
            <TaskSearchResult Task="@selectedTask" Detail="DetailLevel.Full"
                              OnMapClick="@((tuple) => OpenMapForObjective(tuple.objective))" />
            <TaskDetailsTable Task="@selectedTask" OnMapClick="@((tuple) => OpenMapForObjective(tuple.objective))" />
        } else if (Selected?.Data is Map selectedMap) {
            <MapSearchResult Map="@selectedMap" Detail="DetailLevel.Full" ShowExtracts="@_showExtracts"
                             ShowLocks="@_showLocks" ShowTransits="@_showTransits" ShowHazards="@_showHazards"
                             OnShowExtractsChanged="@OnShowExtractsChanged" OnShowLocksChanged="@OnShowLocksChanged"
                             OnShowTransitsChanged="@OnShowTransitsChanged" OnShowHazardsChanged="@OnShowHazardsChanged"
                             OnMapClick="@(() => OpenMapViewer(selectedMap))" />
            <MudPaper Outlined="true" Class="map-frame">
                <MapViewer Map="@selectedMap" Inline="true" Pois="@SelectedMapPois" />
            </MudPaper>
        }
    </MudStack>
</div>

@* Full-screen map viewer, opened from the selected map's info card. Kept
   separate from the selected map so closing it leaves the info card in place. *@
@if (_viewerMap != null) {
    <MapViewer Map="@_viewerMap" Pois="@ViewerPois" FocusPois="@ViewerFocusPois" OnClose="CloseMapViewer" />
}

<style>
    /* Fill the layout's body and clip, so the map at the bottom can absorb the
       leftover height instead of pushing the window into a scroll. .app-body is
       the flex parent, so this needs flex + min-height:0 to shrink properly. */
    .page {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .main-content {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
    }

    /* The cards above the map keep their natural height; only the map frame
       grows. Without flex:none they would be stretched by the column. */
    .search-box,
    .main-content> :not(.map-frame) {
        flex: 0 0 auto;
    }

    /* The map frame takes whatever height is left after the cards above it.
       flex:1 with a 0 basis wins the free space over the default flex-basis,
       and min-height:0 lets it shrink instead of overflowing. */
    .map-frame {
        margin-top: 8px;
        overflow: hidden;
        flex: 1 1 0;
        min-height: 120px;
    }

    .map-frame ::deep .map-viewer-inline {
        margin-top: 0;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    .map-frame ::deep .map-viewer-inline .map-viewer-container {
        border-radius: 0;
        flex: 1;
        min-height: 0;
    }

    .ellipsis {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .selected-result {
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Outlined frame around the inline map, matching the info card and quest
       table borders. Clips the map's corners and gives the map the same inset
       look as the other cards. */
    .map-frame {
        margin-top: 8px;
        overflow: hidden;
    }

    .map-frame ::deep .map-viewer-inline {
        margin-top: 0;
    }

    .map-frame ::deep .map-viewer-container {
        border-radius: 0;
    }

    /* The row stays one line tall and clips whatever runs past its width, rather
       than wrapping or scrolling. */
    .history-row {
        flex-wrap: nowrap;
        overflow: hidden;
        --history-border: var(--mud-palette-lines-default, rgba(255, 255, 255, 0.12));
        --history-border-hover: var(--mud-palette-lines-default, rgba(255, 255, 255, 0.12));
    }

    /* Entries shrink to fit their contents and keep their text on one line, so a
       long item name truncates instead of stretching the row. The visible border
       is what separates one entry from the next, since the row itself has no
       dividers. */
    .history-entry {
        flex: 0 0 auto;
        cursor: pointer;
        border: 1px solid var(--history-border);
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .history-entry:hover {
        background-color: rgba(255, 255, 255, 0.06);
        border-color: var(--history-border-hover);
    }

    /* The entry on screen, tinted so it stands out from the rest of the
       history without needing to be the only border on the row. */
    .history-entry-active {
        background-color: rgba(227, 179, 65, 0.14);
        border-color: rgba(227, 179, 65, 0.55);
    }

    .history-thumb {
        width: 28px;
        height: 28px;
        object-fit: contain;
        flex: 0 0 auto;
    }

    .history-label {
        max-width: 110px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

@code {
    private MudTextField<string> _searchTextField = null!;
    private string _searchText;
    private IEnumerable<SearchResult> _searchResults = new List<SearchResult>();
    private int _selectedResultIndex { get; set; } = 0;

    // Shared with RatScannerMain so the selection survives this component being
    // unmounted by navigating to settings, and so the wiki and tarkov.dev
    // hotkeys read the same answer the display does.
    private static FixedSizeQueue<SearchResult> SelectedResults => RatScannerMain.Instance.SelectedResults;

    private static SearchResult? Selected => RatScannerMain.Instance.Selected;

    private Map? _viewerMap;

    /// <summary>
    /// Brings a history entry back onto the screen. The entry is pushed to the
    /// end of the queue so it becomes the selected one, rather than being swapped
    /// into the tail position, since the queue is what the display reads.
    /// </summary>
    private void SelectHistory(SearchResult entry) {
        if (ReferenceEquals(entry, Selected)) return;

        // Enqueue ignores an entry equal to the current tail, so re-picking what
        // is already showing needs no special case beyond this guard.
        SelectedResults.Enqueue(entry);
        StateHasChanged();
    }

    /// <summary>
    /// Banner art for a map, matching what the map card shows. Falls back to the
    /// shared default banner when the map has none of its own.
    /// </summary>
    private static string? MapBannerUrl(Map map) {
        if (!string.IsNullOrEmpty(map.Id) && MapDataLoader.MapBannerExists(map.Id)) {
            return $"https://local.data/banner/{map.Id}.png";
        }
        return MapDataLoader.DefaultBannerExists ? "https://local.data/banner/default.png" : null;
    }

    /// <summary>
    /// Whether extraction points are overlaid on the maps. Off by default so the
    /// map is not covered in markers unless asked for.
    /// </summary>
    private bool _showExtracts;

    /// <summary>Whether keyed doors and trunks are overlaid on the maps.</summary>
    private bool _showLocks;

    /// <summary>Whether passages to other maps are overlaid on the maps.</summary>
    private bool _showTransits;

    /// <summary>Whether environmental hazards are overlaid on the maps.</summary>
    private bool _showHazards;

    /// <summary>
    /// Lazily-built name lookups, shared by every map the viewer shows. Building
    /// these eagerly would pull the whole items and maps cache in just to resolve
    /// a label, so they are only created once a toggle actually needs one.
    /// </summary>
    private Dictionary<string, string>? _itemNames;
    private Dictionary<string, string>? _mapNames;

    private string? ResolveItemName(string id) {
        _itemNames ??= TarkovDevAPI.GetItems().ToDictionary(i => i.Id, i => i.Name);
        return _itemNames.GetValueOrDefault(id);
    }

    private string? ResolveMapName(string id) {
        _mapNames ??= TarkovDevAPI.GetMaps().ToDictionary(m => m.Id, m => m.Name);
        return _mapNames.GetValueOrDefault(id);
    }

    /// <summary>
    /// The POIs for a map, combining every enabled overlay. Null when nothing is
    /// enabled, so the viewer skips marker rendering entirely.
    /// </summary>
    private List<POI>? BuildPois(Map? map) {
        if (map == null) return null;

        List<POI>? pois = null;

        void Add(List<POI> more) {
            if (more.Count == 0) return;
            (pois ??= []).AddRange(more);
        }

        if (_showExtracts) Add(map.GetExtractPois());
        if (_showLocks) Add(map.GetLockPois(ResolveItemName));
        if (_showTransits) Add(map.GetTransitPois(ResolveMapName));
        if (_showHazards) Add(map.GetHazardPois());

        return pois;
    }

    /// <summary>
    /// Extracts for the map shown inline, or null when the toggle is off or the
    /// map has none.
    /// </summary>
    private List<POI>? SelectedMapPois => BuildPois(Selected?.Data is Map selectedMap ? selectedMap : null);

    /// <summary>
    /// Same, for the full-screen viewer. Kept separate from the inline map since
    /// it can show a different map than the selected one.
    /// </summary>
    private List<POI>? ViewerMapPois => BuildPois(_viewerMap);

    /// <summary>
    /// Zones for a quest objective's map, held while the viewer is open so the
    /// objective's areas stay on the map alongside the toggle overlays. Kept
    /// separate from the overlay toggles because these are not user-selectable:
    /// they come from whichever objective was clicked.
    /// </summary>
    private List<POI>? _viewerZonePois;

    /// <summary>
    /// The full-screen viewer's markers: the enabled overlays for whatever map
    /// is open, plus the objective zones if an objective put us here.
    /// </summary>
    private List<POI>? ViewerPois {
        get {
            var overlays = ViewerMapPois;
            if (_viewerZonePois == null || _viewerZonePois.Count == 0) return overlays;

            var combined = new List<POI>();
            if (overlays != null) combined.AddRange(overlays);
            combined.AddRange(_viewerZonePois);
            return combined;
        }
    }

    /// <summary>
    /// The markers the viewer should open centred on. Only the objective zones:
    /// these are what the user asked to see, whereas the extraction and door
    /// overlays can be anywhere on the map and would drag the view off target.
    /// Null when the viewer was opened from a map rather than an objective, so
    /// the map shows in its default position.
    /// </summary>
    private List<POI>? ViewerFocusPois => _viewerZonePois is { Count: > 0 } ? _viewerZonePois : null;

    private void OnShowExtractsChanged(bool value) {
        _showExtracts = value;
    }

    private void OnShowLocksChanged(bool value) {
        _showLocks = value;
    }

    private void OnShowTransitsChanged(bool value) {
        _showTransits = value;
    }

    private void OnShowHazardsChanged(bool value) {
        _showHazards = value;
    }

    protected override void OnInitialized() {
        MenuVM.PropertyChanged += PropertyChangeHandler;
        MenuVM.ItemScans.Enqueued += OnItemScanEnqueued;
        RatScannerMain.Instance.HotkeyManager.EscapePressed += OnEscapePressed;
        SettingsVM.GameModeChanged += OnGameModeChanged;
    }

    /// <summary>
    /// The selected item, quest and map carry over to the new mode untouched. The
    /// data behind them may be stale, but losing the selection mid-switch is
    /// worse than showing last mode's prices for a moment.
    /// </summary>
    private void OnGameModeChanged(GameMode mode) {
        _itemNames = null;
        _mapNames = null;
        _searchResults = [];
        _viewerMap = null;
        _viewerZonePois = null;

        // The queued results hold items deserialized for the old mode, so their
        // prices and trader offers are the old mode's. Swapping in the new mode's
        // entry for the same id refreshes them.
        var refreshed = SelectedResults.Select(r => r.Data switch {
            Item item => new SearchResult(
                TarkovDevAPI.GetItems().FirstOrDefault(i => i.Id == item.Id) ?? item, r.Score),
            TarkovTask task => new SearchResult(
                TarkovDevAPI.GetTasks().FirstOrDefault(t => t.Id == task.Id) ?? task, r.Score),
            Map map => new SearchResult(
                TarkovDevAPI.GetMaps().FirstOrDefault(m => m.Id == map.Id) ?? map, r.Score),
            _ => r,
        }).ToList();

        SelectedResults.Clear();
        foreach (var r in refreshed) SelectedResults.Enqueue(r);

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Closes the full-screen map viewer when Escape is pressed. Returns whether
    /// the key was consumed, so the hotkey manager only falls through to closing
    /// the interactive overlay when there is no map to dismiss.
    /// </summary>
    private bool OnEscapePressed() {
        if (_viewerMap == null) return false;

        _ = InvokeAsync(CloseMapViewer);
        return true;
    }

    private async void ExecuteSearch(string value) {
        var sanitizedValue = SearchService.SanitizeSearch(value);
        var results = Enumerable.Empty<SearchResult>();
        results = results.Concat(await SearchService.SearchItemsAsync(sanitizedValue));
        results = results.Concat(await SearchService.SearchTasksAsync(sanitizedValue));
        results = results.Concat(await SearchService.SearchMapsAsync(sanitizedValue));
        results = results.Where(result => result != null && result.Data != null);
        results = results.OrderBy(result => result.Score).Take(4);
        _searchResults = results;
        _selectedResultIndex = 0;
    }

    private void SelectResult(int index) {
        _selectedResultIndex = index;
        SelectedResults.Enqueue(_searchResults.ElementAt(_selectedResultIndex));
        _searchTextField.Clear();
        _searchResults = [];
        StateHasChanged();
    }

    /// <summary>
    /// Opens the full-screen viewer for a map. Maps without interactive SVG data
    /// have nothing to draw, so those are ignored rather than opening a blank
    /// overlay.
    /// </summary>
    private void OpenMapViewer(Map map) {
        if (string.IsNullOrEmpty(MapDataLoader.GetMapSvgUrl(map.Id))) return;

        _viewerMap = map;
        // Zones belong to the objective that opened the viewer, so a plain map
        // open must not inherit them from a previous objective.
        _viewerZonePois = null;
        StateHasChanged();
    }

    private void CloseMapViewer() {
        _viewerMap = null;
        _viewerZonePois = null;
        StateHasChanged();
    }

    /// <summary>
    /// Opens the full-screen viewer on the map a quest objective happens in,
    /// with the objective's zones drawn as areas.
    /// </summary>
    private void OpenMapForObjective(TaskObjective objective) {
        if (objective?.Zones == null || objective.Zones.Count == 0) return;

        // Zones are per-map. The first one picks the map to open, so an
        // objective spanning several maps starts on the one it lists first.
        var mapId = objective.Zones
            .Select(z => z?.Map)
            .FirstOrDefault(m => !string.IsNullOrEmpty(m));
        if (mapId == null) return;

        var map = TarkovDevAPI.GetMaps().FirstOrDefault(m => m.Id == mapId);
        if (map == null) return;

        // A map with no SVG has nothing to draw the zones onto.
        if (string.IsNullOrEmpty(MapDataLoader.GetMapSvgUrl(map.Id))) return;

        // Keep the overlay toggles as they were; the zones are extra markers,
        // not a replacement.
        _viewerMap = map;
        _viewerZonePois = map.GetZonePois(objective.Zones);
        if (_viewerZonePois.Count == 0) return;

        StateHasChanged();
    }

    private void OpenURL(string? url) {
        if (string.IsNullOrEmpty(url)) return;
        var psi = new ProcessStartInfo {
            FileName = url,
            UseShellExecute = true,
        };
        Process.Start(psi);
    }

    private void OnItemScanEnqueued(object? sender, ItemScan scan) {
        var result = new SearchResult(scan.Item, 0);
        SelectedResults.Enqueue(result);
        _ = InvokeAsync(StateHasChanged);
    }

    private void PropertyChangeHandler(object? sender, EventArgs e) {
        // Fire and forget: the scan timer fires this ~10x a second, and the
        // dispatcher is torn down when the window closes. Awaited here, the
        // cancellation that follows the teardown escapes an async void and
        // breaks the debugger on the way out.
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        MenuVM.PropertyChanged -= PropertyChangeHandler;
        MenuVM.ItemScans.Enqueued -= OnItemScanEnqueued;
        RatScannerMain.Instance.HotkeyManager.EscapePressed -= OnEscapePressed;
        SettingsVM.GameModeChanged -= OnGameModeChanged;
    }
}
