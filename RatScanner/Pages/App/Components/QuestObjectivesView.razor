@using RatScanner.FetchModels.TarkovTracker
@using RatScanner.TarkovDev.Json
@using Color = MudBlazor.Color

@*
    Objectives of a quest, with completion state and counters taken from
    TarkovTracker. Shared by ItemQuestTable (the item quest rows) and
    TaskDetailsTable (the quest detail view) so both render objectives the
    same way.

    Callers pass the objective list directly plus whether the whole task is
    done, since finishing a task marks every one of its objectives done.
*@

@if (Objectives.Count == 0) {
    <div class="objective-list">
        <span class="objective-empty">@Localizer["QuestNoObjectives"]</span>
    </div>
} else {
    <div class="objective-list">
        @foreach (var objective in Objectives) {
            var isDone = TaskComplete || objective.IsComplete;
            var items = objective.AlternateItems;
            <div class="@("objective" + (isDone ? " objective-done" : ""))">
                @* Editing is only offered when the local store is the source, since the
                   tracker would overwrite it. *@
                @if (objective.CanEdit) {
                    <MudTooltip Text="@(isDone ? Localizer["QuestMarkIncomplete"] : Localizer["QuestMarkComplete"])"
                                Placement="Placement.Top" Delay="200">
                        <ChildContent>
                            <MudIconButton
                            Icon="@(isDone ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.CheckCircle)"
                            Size="Size.Small" Color="@(isDone ? Color.Success : Color.Default)"
                            OnClick="@(() => ToggleAsync(objective, isDone))" />
                        </ChildContent>
                    </MudTooltip>
                } else if (isDone) {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                } else {
                    <MudIcon Icon="@Constants.Icon.TaskObjective.FromType(objective.Objective.Type)" Size="Size.Small" />
                }
                <div class="objective-text">
                    <span>@objective.Description</span>
                    @if (objective.Required > 0) {
                        <span class="objective-count">@($"{objective.ProgressCount}/{objective.Required}")</span>
                    }
                    @if (ShowOptional && objective.Objective.Optional) {
                        <span class="objective-flag">@Localizer["QuestOptional"]</span>
                    }
                    @if (objective.Objective.FoundInRaid) {
                        <MudTooltip Text="@Localizer["QuestFirHint"]" Placement="Placement.Top" Delay="200" Class="flag-tooltip">
                            <ChildContent>
                                <span class="objective-flag objective-fir">FIR</span>
                            </ChildContent>
                        </MudTooltip>
                    }
                    @if (objective.HasAlternates) {
                        <MudTooltip Text="@Localizer["QuestAnyOfHint"]" Placement="Placement.Top" Delay="200" Class="flag-tooltip">
                            <ChildContent>
                                <span class="objective-flag objective-any">@Localizer["QuestAnyOf"]</span>
                            </ChildContent>
                        </MudTooltip>
                    }
                </div>
                @* Only offered when the objective actually says where it happens. Most
                   objectives are about items or traders and have no location, so
                   a button there would open a map with nothing on it. *@
                @if (OnMapClick.HasDelegate && Task is not null && HasLocation(objective.Objective)) {
                    <MudIconButton Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Primary"
                                   title="@Localizer["QuestViewOnMap"]"
                                   OnClick="@(() => OnMapClick.InvokeAsync((Task, objective.Objective)))" />
                }
                @if (objective.CanEdit && objective.Required > 1) {
                    <div class="objective-stepper">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                       Disabled="@(objective.ProgressCount <= 0)" title="@Localizer["QuestDecrease"]"
                                       OnClick="@(() => StepAsync(objective, -1))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       Disabled="@(objective.ProgressCount >= objective.Required)" title="@Localizer["QuestIncrease"]"
                                       OnClick="@(() => StepAsync(objective, 1))" />
                    </div>
                }
            </div>
            @if (items.Count > 0) {
                <div class="alternate-items">
                    @foreach (var item in items) {
                        <div class="alternate-item">
                            <MudImage Src="@item.BaseImageLink" Style="width: 100%; height: 44px; object-fit: contain;" />
                            <span>@item.Name</span>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

<style>
    /* These rules live here rather than in the calling tables because Blazor
       scopes CSS to the component that owns the markup, and this component is
       what renders every objective. Losing them turns the row into stacked
       block elements and strips the flags of their borders. */
    .objective-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 4px 8px 8px 8px;
        min-width: 0;
    }

    .objective {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        /* Without this a long description can push the trailing map button
           onto its own line instead of letting the text truncate. */
        min-width: 0;
    }

    .objective-done {
        opacity: 0.6;
    }

    .objective-text {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
        /* Must be allowed to shrink, otherwise it claims the full row width and
           pushes the trailing buttons past the end. */
        flex: 1 1 auto;
        overflow: hidden;
    }

    .objective-count,
    .objective-flag,
    .objective-empty {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary, rgba(255, 255, 255, 0.5));
    }

    .objective-flag {
        border: 1px solid var(--mud-palette-lines-default, rgba(255, 255, 255, 0.12));
        border-radius: 4px;
        padding: 0 4px;
    }

    /* FIR is a warning-style constraint, so give it a warm accent to set it
       apart from the neutral flags. */
    .objective-fir {
        color: #f0a02a;
        border-color: rgba(240, 160, 42, 0.45);
    }

    /* ANY means the objective has substitutes, a positive/relaxed condition. */
    .objective-any {
        color: #66bb6a;
        border-color: rgba(102, 187, 106, 0.45);
    }

    .objective-empty {
        color: var(--mud-palette-text-secondary, rgba(255, 255, 255, 0.5));
        font-size: 0.85rem;
    }

    /* Horizontal single-row strip, below the objective it belongs to.
       box-sizing + width:100% + min-width:0 stop the tiles' max-content
       width propagating up the flex chain, which would otherwise make the
       whole quest section scroll sideways instead of just this strip. */
    .alternate-items {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        margin: 2px 0 4px 0;
        padding: 2px 0 4px 24px;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
    }

    .alternate-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 0 0 64px;
        width: 64px;
        text-align: center;
        font-size: 0.7rem;
        line-height: 1.2;
    }

    .alternate-item .mud-image {
        width: 100%;
    }

    .alternate-item span {
        margin-top: 2px;
        width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<style>
    /* Tooltips render through MudPopoverProvider, so this must be global:
       scoped CSS would never match the popover. The default mud-tooltip
       styling is a light grey that clashes with the dark theme. */
    ::deep .flag-tooltip,
    .flag-tooltip {
        background: #1e1e1e;
        color: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-weight: 400;
    }

    /* Never shrunk, so the map and stepper buttons keep their place however long
       the description is. */
    .objective-stepper {
        display: flex;
        align-items: center;
        gap: 0;
        flex-shrink: 0;
    }

    .objective> :deep(.mud-icon-button) {
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter]
    public EventCallback<bool> OnProgressEdited { get; set; }

    /// <summary>Objectives to render, already paired with tracker state.</summary>
    [Parameter, EditorRequired]
    public List<QuestObjectiveEntry> Objectives { get; set; } = null!;

    /// <summary>Whether the whole task is done, which marks every objective done.</summary>
    [Parameter]
    public bool TaskComplete { get; set; }

    /// <summary>
    /// The task these objectives belong to. Only needed when
    /// <see cref="OnMapClick"/> is wired up.
    /// </summary>
    [Parameter]
    public TarkovTask? Task { get; set; }

    /// <summary>
    /// Per-objective map button target. Left unset outside the overlay, which
    /// hides the button rather than opening a viewer that is not there.
    /// </summary>
    [Parameter]
    public EventCallback<(TarkovTask task, TaskObjective objective)> OnMapClick { get; set; }

    /// <summary>
    /// Whether an objective points at a place on a map. Zones carry the actual
    /// geometry; the map id list alone is not enough, since a map we cannot
    /// project would still leave the button with nothing to show.
    /// </summary>
    private static bool HasLocation(TaskObjective? objective) {
        if (objective?.Zones == null) return false;
        return objective.Zones.Any(z => z != null && (z.Position != null || (z.Outline is { Count: >= 3 })));
    }

    private async Task ToggleAsync(QuestObjectiveEntry objective, bool isDone) {
        objective.SetComplete(!isDone);
        await OnProgressEdited.InvokeAsync(true);
    }

    private async Task StepAsync(QuestObjectiveEntry objective, int delta) {
        objective.Step(delta);
        await OnProgressEdited.InvokeAsync(true);
    }

    /// <summary>
    /// Whether to flag optional objectives. Off for the item quest rows, which
    /// fold optional objectives into the count they already display.
    /// </summary>
    [Parameter]
    public bool ShowOptional { get; set; }

    [Inject]
    public LocalizationService Localizer { get; set; } = null!;
}