@using RatScanner.FetchModels.TarkovTracker
@using RatScanner.TarkovDev.Json
@using Color = MudBlazor.Color
@implements IDisposable

@*
    Two quest tables for an item, mirroring tarkov.dev: quests that require
    handing the item in, and quests that reward it.

    Each row expands to show the task objectives, with completion state and
    counters taken from TarkovTracker.
*@

@if (Requiring.Count > 0) {
    <div class="quest-section">
        <MudText Typo="Typo.h6" Class="quest-title">@Localizer["QuestsRequiring"] @Item.Name</MudText>
        <MudTable T="QuestItemEntry" Items="@Requiring" Dense="true" Hover="true" Elevation="0" Outlined="true"
                  Breakpoint="Breakpoint.None" RowClassFunc="@RowClass" OnRowClick="@(args => Toggle(args.Item))"
                  Class="quest-table">
            <ColGroup>
                <col style="width: 40px;" />
                <col />
                <col />
            </ColGroup>
            <HeaderContent>
                <MudTh></MudTh>
                <MudTh>@Localizer["QuestTask"]</MudTh>
                <MudTh>@Localizer["QuestRequiredItems"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="entry">
                <MudTd DataLabel="">
                    <MudIcon Icon="@ExpandIcon(entry.IsExpanded)" Size="Size.Small" />
                </MudTd>
                <MudTd DataLabel="@Localizer["QuestTask"]">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudImage Src="@(entry.Task.Trader?.ImageLink ?? entry.Task.TaskImageLink)"
                                  Style="width: 40px; height: 40px; object-fit: contain;" />
                        <MudStack Spacing="0" Style="min-width: 0;">
                            <MudText Typo="Typo.body2" Class="@($"quest-name{(entry.IsComplete ? " quest-done" : "")}")">
                                @entry.Task.Name</MudText>
                                @if (entry.IsComplete) {
                                    <MudText Typo="Typo.caption" Color="Color.Success">@Localizer["QuestCompleted"]</MudText>
                                } else if (entry.IsFailed) {
                                    <MudText Typo="Typo.caption" Color="Color.Error">@Localizer["QuestFailed"]</MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["QuestRequiredItems"]">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudPaper Style="width: 48px; height: 48px;" Outlined="true">
                                <MudImage Src="@Item.BaseImageLink" Style="width: 100%; height: 100%; object-fit: contain;" />
                            </MudPaper>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@Item.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @string.Format(Localizer["QuestAmount"], entry.Count)@(entry.HasAlternates ? $" ({Localizer["QuestHasAlternates"]})" : "")
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <ChildRowContent Context="entry">
                    @if (entry.IsExpanded) {
                        <MudTr Item="@entry">
                            <MudTd colspan="3">
                                <div class="objective-cell" @onclick:stopPropagation="true">
                                    <QuestObjectivesView Objectives="entry.ObjectiveList" TaskComplete="entry.IsComplete"
                                                         Task="@entry.Task" OnProgressEdited="OnProgressEdited" />
                                </div>
                            </MudTd>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </div>
    }

    @if (Rewarding.Count > 0) {
        <div class="quest-section">
            <MudText Typo="Typo.h6" Class="quest-title">@Localizer["QuestsRewarding"] @Item.Name</MudText>
            <MudTable T="QuestItemEntry" Items="@Rewarding" Dense="true" Hover="true" Elevation="0" Outlined="true"
                      Breakpoint="Breakpoint.None" RowClassFunc="@RowClass" OnRowClick="@(args => Toggle(args.Item))"
                      Class="quest-table">
                <ColGroup>
                    <col style="width: 40px;" />
                    <col />
                    <col />
                </ColGroup>
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>@Localizer["QuestTask"]</MudTh>
                    <MudTh>@Localizer["QuestRewardItems"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="entry">
                    <MudTd DataLabel="">
                        <MudIcon Icon="@ExpandIcon(entry.IsExpanded)" Size="Size.Small" />
                    </MudTd>
                    <MudTd DataLabel="@Localizer["QuestTask"]">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudImage Src="@(entry.Task.Trader?.ImageLink ?? entry.Task.TaskImageLink)"
                                      Style="width: 40px; height: 40px; object-fit: contain;" />
                            <MudStack Spacing="0" Style="min-width: 0;">
                                <MudText Typo="Typo.body2" Class="@($"quest-name{(entry.IsComplete ? " quest-done" : "")}")">
                                    @entry.Task.Name</MudText>
                                    @if (entry.IsComplete) {
                                        <MudText Typo="Typo.caption" Color="Color.Success">@Localizer["QuestCompleted"]</MudText>
                                    } else if (entry.IsFailed) {
                                        <MudText Typo="Typo.caption" Color="Color.Error">@Localizer["QuestFailed"]</MudText>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["QuestRewardItems"]">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudPaper Style="width: 48px; height: 48px;" Outlined="true">
                                    <MudImage Src="@Item.BaseImageLink" Style="width: 100%; height: 100%; object-fit: contain;" />
                                </MudPaper>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@Item.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @string.Format(Localizer["QuestAmount"], entry.Count)
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["QuestOnTaskCompletion"]
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <ChildRowContent Context="entry">
                        @if (entry.IsExpanded) {
                            <MudTr Item="@entry">
                                <MudTd colspan="3">
                                    <div class="objective-cell" @onclick:stopPropagation="true">
                                        <QuestObjectivesView Objectives="entry.ObjectiveList" TaskComplete="entry.IsComplete"
                                                             Task="@entry.Task" OnProgressEdited="OnProgressEdited" />
                                    </div>
                                </MudTd>
                            </MudTr>
                        }
                    </ChildRowContent>
                </MudTable>
            </div>
        }

@code {
    [Parameter, EditorRequired]
    public Item Item { get; set; } = null!;

    [Inject]
    public LocalizationService Localizer { get; set; } = null!;

    private List<QuestItemEntry> _requiring = [];
    private List<QuestItemEntry> _rewarding = [];

    private Item? _builtFor;
    private UserProgress? _builtProgress;

    /// <summary>
    /// Ids of the rows the player has opened. Expansion has to outlive a rebuild:
    /// editing an objective replaces the progress object, which forces a rebuild,
    /// and <see cref="QuestItemEntry.IsExpanded"/> is a mutable property on a
    /// record, so freshly built entries always come back collapsed. Ticking an
    /// objective therefore folded the row shut under the player's cursor.
    /// </summary>
    private readonly HashSet<string> _expandedTasks = [];

    /// <summary>
    /// Rebuilds the rows when the item or the progress behind them changed.
    ///
    /// Called from the render path, not OnParametersSet: that only runs when the
    /// parent supplies new parameters, so a self-repaint after an edit would
    /// leave the stale rows in place. Both tables build together because they
    /// share the cache marker.
    /// </summary>
    private void EnsureBuilt() {
        var progress = Item.SelfProgress;

        if (ReferenceEquals(_builtFor, Item) && ReferenceEquals(_builtProgress, progress)) return;

        // A different item means a different set of quests, so open rows from
        // the previous item must not carry over.
        if (!ReferenceEquals(_builtFor, Item)) {
            _expandedTasks.Clear();
        }

        _builtFor = Item;
        _builtProgress = progress;
        _requiring = Build(Item.GetQuestsRequiringItem(), progress, _expandedTasks);
        _rewarding = Build(Item.GetQuestsRewardingItem(), progress, _expandedTasks);
    }

    private List<QuestItemEntry> Requiring {
        get {
            EnsureBuilt();
            return _requiring;
        }
    }

    private List<QuestItemEntry> Rewarding {
        get {
            EnsureBuilt();
            return _rewarding;
        }
    }

    protected override void OnInitialized() => LocalProgressStore.Changed += OnLocalProgressChanged;

    public void Dispose() => LocalProgressStore.Changed -= OnLocalProgressChanged;

    private Task OnProgressEdited(bool _) {
        _builtProgress = null;
        StateHasChanged();
        return System.Threading.Tasks.Task.CompletedTask;
    }

    private void OnLocalProgressChanged() => InvokeAsync(() => {
        _builtProgress = null;
        StateHasChanged();
    });

    private static List<QuestItemEntry> Build(List<QuestItemEntry> entries, UserProgress progress, HashSet<string> expanded) {
        return entries.Select(entry => {
            var built = entry with {
                IsComplete = Item.IsTaskComplete(entry.Task, progress),
                IsFailed = Item.IsTaskFailed(entry.Task, progress),
                Objectives = Item.GetObjectiveProgress(entry.Task, progress),
            };

            // `with` copies IsExpanded from the source entry, but the source is a
            // throwaway built by GetQuests*Item(), so it is always false. Restore
            // it from the set of tasks the player has open instead.
            built.IsExpanded = entry.Task.Id is { Length: > 0 } id && expanded.Contains(id);
            return built;
        }).ToList();
    }

    // The MudTr inside ChildRowContent has no Item, and MudTable hands its click
    // through anyway, so args.Item can be null when the expanded area is clicked.
    private void Toggle(QuestItemEntry? entry) {
        if (entry is null) {
            return;
        }

        entry.IsExpanded = !entry.IsExpanded;

        if (entry.Task.Id is not { Length: > 0 } id) {
            return;
        }

        if (entry.IsExpanded) {
            _expandedTasks.Add(id);
        } else {
            _expandedTasks.Remove(id);
        }
    }

    private static string ExpandIcon(bool expanded) =>
        expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore;

    private static string? RowClass(QuestItemEntry entry, int rowIndex) =>
        entry.IsComplete ? "quest-row-done" : null;
}

<style>
    .quest-section {
        margin-top: 8px;
    }

    .quest-title {
        margin-bottom: 4px;
    }

    .quest-row-done {
        opacity: 0.6;
    }

    .quest-done {
        text-decoration: line-through;
    }

    /* MudTable puts Class on the outer wrapper div, not the table element, so
       table-layout has to target the table root directly. Without the fixed
       layout the colspan=3 child row contributes its max-content width to the
       table and pushes the later columns out of view. */
    .quest-table {
        width: 100%;
    }

    .quest-table .mud-table-root {
        table-layout: fixed;
    }

    .quest-table .mud-table-container {
        overflow-x: hidden;
    }

    .quest-table .mud-table-cell {
        overflow-wrap: anywhere;
    }

    .quest-name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Without this the expanded item strip's max-content width propagates up
       and the whole quest section scrolls sideways instead of just the strip.
       The objective row styles themselves live in QuestObjectivesView, which
       is the component that renders them. */

    .objective-cell {
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
    }
</style>
