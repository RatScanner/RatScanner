@using RatScanner.TarkovDev.Json
@using Color = MudBlazor.Color
@using System.Diagnostics;

@*
    Renders a map in the two contexts a map can appear in:

    SearchRow  - a bare row in the main UI search list, clickable to open the map
    OverlayRow - a compact overlay row, which opens the map directly on click
*@

<MudPaper Class="pa-2 overflow-hidden" Elevation="3" Style="cursor: pointer;">
    @if (Detail == DetailLevel.SearchRow) {
        <MudStack Row="true" Justify="Justify.FlexStart" Class="flex-1" Style="height: 6vh;" @onclick="OnMapClick">
            <MudStack Justify="Justify.Center" Class="flex-shrink-0">
                <MudPaper Outlined="true" Style="height: 100%; aspect-ratio: 1 / 1; overflow: hidden;">
                    @if (BannerUrl is not null) {
                        <MudImage Src="@BannerUrl" Alt="@Map.Name" Style="width: 100%; height: 100%; object-fit: cover;" />
                    } else {
                        <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Primary" />
                    }
                </MudPaper>
            </MudStack>

            <MudStack Justify="Justify.SpaceEvenly" AlignItems="AlignItems.Start">
                <MudText Typo="Typo.body1" Class="ellipsis">
                    @Map.Name
                </MudText>
            </MudStack>
        </MudStack>
    }

    @if (Detail == DetailLevel.OverlayRow) {
        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="min-height: 40px;">
            <MudStack Row="true" Justify="Justify.FlexStart" Class="flex-1" Style="min-width: 0;">
                <MudPaper Outlined="true" Style="width: 48px; height: 48px; min-width: 48px; overflow: hidden;">
                    @if (BannerUrl is not null) {
                        <MudImage Src="@BannerUrl" Alt="@Map.Name" Style="width: 100%; height: 100%; object-fit: cover;" />
                    } else {
                        <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Medium" Color="Color.Primary" />
                    }
                </MudPaper>

                <MudStack Spacing="0" Style="min-width: 0; overflow: hidden;">
                    <MudText Typo="Typo.subtitle1" Class="ellipsis">@Map.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ellipsis">
                        @Localizer["QuestViewMapHint"]
                    </MudText>
                </MudStack>
            </MudStack>

            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Primary" />
        </MudStack>
    }

    @if (Detail == DetailLevel.Full) {
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold px-1 pb-1"
                 Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            @Map.Name
        </MudText>

        <div class="d-flex align-start pa-1" Style="gap: 8px;">
            <!-- Left: the map's banner art, in the same fixed square the item card uses.
                 Falls back to a map glyph when the map has no banner on disk. -->
            <MudPaper Outlined="true" Class="flex-shrink-0"
                      Style="width: 104px; height: 104px; overflow: hidden;">
                @if (BannerUrl is not null) {
                    <MudImage Src="@BannerUrl" Alt="@Map.Name" Style="width: 100%; height: 100%; object-fit: cover;" />
                } else {
                    <div class="d-flex align-center justify-center" Style="width: 100%; height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Large" Color="Color.Primary" />
                    </div>
                }
            </MudPaper>

            <div class="flex-grow-1" Style="min-width: 0;">
                <MudStack Spacing="1">
                    <MudPaper Outlined="true" Class="pa-2">
                        <div class="d-flex align-center flex-wrap" Style="gap: 4px;">
                            <MudFlexWrap Spacing="1" Class="gap-1 flex-grow-1">
                                <MudChip T="string" Icon="@Icons.Material.Filled.Map" Variant="Variant.Filled"
                                         Color="Color.Primary" Size="Size.Small">
                                    @Localizer["MapName"]
                                </MudChip>

                                @if (!string.IsNullOrEmpty(Map.ScenePath)) {
                                    <MudChip T="string" Icon="@Icons.Material.Filled.Landscape" Variant="Variant.Outlined"
                                             Color="Color.Secondary" Size="Size.Small">
                                        @Localizer["MapScene"]
                                    </MudChip>
                                }

                                @if (HasSvg) {
                                    <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Variant="Variant.Outlined"
                                             Color="Color.Success" Size="Size.Small">
                                        @Localizer["MapInteractive"]
                                    </MudChip>
                                } else {
                                    <MudTooltip Text="@Localizer["MapNoDataHint"]" Placement="Placement.Top" Delay="200">
                                        <ChildContent>
                                            <MudChip T="string" Icon="@Icons.Material.Filled.HelpOutline"
                                                     Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small">
                                                @Localizer["MapNoData"]
                                            </MudChip>
                                        </ChildContent>
                                    </MudTooltip>
                                }
                            </MudFlexWrap>

                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Disabled="@(!HasSvg)"
                                       OnClick="@(() => OnMapClick.InvokeAsync())">
                                @Localizer["MapOpen"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                       OnClick="@(() => OpenURL(Map.Wiki))">
                                Wiki
                            </MudButton>
                        </div>
                    </MudPaper>

                    @* Overlay toggles for the map below. Each control is hidden entirely when
                       the map has nothing to show for it, rather than shown
                       disabled, so the card stays uncluttered. *@
                    @if (Map.Extracts.Count > 0 || Map.Locks.Count > 0 || Map.Transits.Count > 0 || Map.Hazards.Count > 0) {
                        @* Overlay toggles as one joined row of buttons. Four stacked
                           labelled switches took four lines and squeezed the map
                           out of the card, and icon-only buttons lost the labels
                           entirely, so these keep a short label plus an icon and
                           sit side by side in a single row.

                           Each overlay keeps its own colour in both states, so the
                           buttons match the markers they toggle: green for
                           extracts, amber for keyed doors, blue for passages and
                           red for hazards. Colour carries the meaning even when
                           the labels are unreadable.

                           MudToggleIconButton is deliberately not used here: in
                           MudBlazor 6.10 it derives from MudComponentBase rather
                           than MudBaseButton, so it cannot join a button group's
                           borders, and it has no ChildContent to hold a label.
                           MudButton is group-compatible and carries both.

                           Colors are MudBlazor presets rather than exact hex:
                           Color is a preset-only struct with no FromHtml, so the
                           button tints are the nearest palette match to the POI
                           marker colours rather than the identical value. *@
                        <MudPaper Outlined="true" Class="pa-2">
                            <MudButtonGroup Variant="Variant.Outlined" OverrideStyles="false" Size="Size.Small"
                                            Color="Color.Primary">
                                @if (Map.Extracts.Count > 0) {
                                    <MudButton StartIcon="@Icons.Material.Filled.Logout"
                                               Variant="@(ShowExtracts ? Variant.Filled : Variant.Outlined)" Color="Color.Success"
                                               OnClick="@(() => OnShowExtractsChanged.InvokeAsync(!ShowExtracts))">
                                        @Localizer["MapOverlayExtractsShort"]
                                    </MudButton>
                                }
                                @if (Map.Locks.Count > 0) {
                                    <MudButton StartIcon="@Icons.Material.Filled.Key"
                                               Variant="@(ShowLocks ? Variant.Filled : Variant.Outlined)" Color="Color.Warning"
                                               OnClick="@(() => OnShowLocksChanged.InvokeAsync(!ShowLocks))">
                                        @Localizer["MapOverlayLocksShort"]
                                    </MudButton>
                                }
                                @if (Map.Transits.Count > 0) {
                                    <MudButton StartIcon="@Icons.Material.Filled.CompareArrows"
                                               Variant="@(ShowTransits ? Variant.Filled : Variant.Outlined)" Color="Color.Info"
                                               OnClick="@(() => OnShowTransitsChanged.InvokeAsync(!ShowTransits))">
                                        @Localizer["MapOverlayTransitsShort"]
                                    </MudButton>
                                }
                                @if (Map.Hazards.Count > 0) {
                                    <MudButton StartIcon="@Icons.Material.Filled.Warning"
                                               Variant="@(ShowHazards ? Variant.Filled : Variant.Outlined)" Color="Color.Error"
                                               OnClick="@(() => OnShowHazardsChanged.InvokeAsync(!ShowHazards))">
                                        @Localizer["MapOverlayHazardsShort"]
                                    </MudButton>
                                }
                            </MudButtonGroup>
                        </MudPaper>
                    }
                </MudStack>
            </div>
        </div>
    }
</MudPaper>

<style>
    .ellipsis {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
    }
</style>

@code {
    [Parameter]
    public DetailLevel Detail { get; set; } = DetailLevel.SearchRow;

    [Parameter]
    public required Map Map { get; set; }

    [Parameter]
    public EventCallback OnMapClick { get; set; }

    /// <summary>
    /// Whether extraction points are overlaid on the map. Defaults to off so
    /// the map is not covered in markers unless asked for.
    /// </summary>
    [Parameter]
    public bool ShowExtracts { get; set; }

    /// <summary>
    /// Whether keyed doors and trunks are overlaid on the map.
    /// </summary>
    [Parameter]
    public bool ShowLocks { get; set; }

    /// <summary>
    /// Whether passages to other maps are overlaid on the map.
    /// </summary>
    [Parameter]
    public bool ShowTransits { get; set; }

    /// <summary>
    /// Whether environmental hazards are overlaid on the map.
    /// </summary>
    [Parameter]
    public bool ShowHazards { get; set; }

    /// <summary>
    /// Raised when the extracts switch is toggled, so the owning page can pass
    /// the POIs down to the viewer.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnShowExtractsChanged { get; set; }

    /// <summary>Raised when the keyed doors switch is toggled.</summary>
    [Parameter]
    public EventCallback<bool> OnShowLocksChanged { get; set; }

    /// <summary>Raised when the transits switch is toggled.</summary>
    [Parameter]
    public EventCallback<bool> OnShowTransitsChanged { get; set; }

    /// <summary>Raised when the hazards switch is toggled.</summary>
    [Parameter]
    public EventCallback<bool> OnShowHazardsChanged { get; set; }

    [Inject]
    public LocalizationService Localizer { get; set; } = null!;

    /// <summary>
    /// Whether interactive SVG data exists for this map. Maps without it have
    /// nothing the viewer can draw, so the open button is disabled rather than
    /// opening an empty overlay.
    /// </summary>
    private bool HasSvg => !string.IsNullOrEmpty(MapDataLoader.GetMapSvgUrl(Map.Id));

    /// <summary>
    /// The map's banner art, served from the local Data folder, which the
    /// WebView exposes as https://local.data. Falls back to the shared banner
    /// when a map has no art of its own, and to null when even that is missing.
    /// </summary>
    private string? BannerUrl {
        get {
            if (!string.IsNullOrEmpty(Map.Id) && MapDataLoader.MapBannerExists(Map.Id)) {
                return $"https://local.data/banner/{Map.Id}.png";
            }
            return MapDataLoader.DefaultBannerExists ? "https://local.data/banner/default.png" : null;
        }
    }

    private void OpenURL(string? url) {
        if (string.IsNullOrEmpty(url)) return;
        var psi = new ProcessStartInfo {
            FileName = url,
            UseShellExecute = true,
        };
        Process.Start(psi);
    }
}
