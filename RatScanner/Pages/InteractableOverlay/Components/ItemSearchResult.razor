@using RatScanner.TarkovDev.Json
@using Color = MudBlazor.Color
@using System.Diagnostics;

@*
    Renders an item in three contexts:

    SearchRow       - a bare row in the main UI search list
    OverlayRow      - a compact row in the interactive overlay: name, short name,
                      quest and hideout counts, price, best trader offer
    OverlayExpanded - not used for items; the selected overlay result is shown at
                      full detail instead, since expanding an item means showing its
                      prices
    Full            - the full card: best sell/buy pricing, requirement chips
                      and, for ammo, the same-caliber comparison table
*@

<MudPaper Class="@(Detail == DetailLevel.Full ? "pa-1 overflow-hidden" : "pa-2 overflow-hidden")" Elevation="3"
          Style="@(Detail == DetailLevel.Full ? "" : "cursor: pointer;")" @onclick="HandleClick">
    @{
        string minHeight = Detail switch {
            DetailLevel.OverlayRow => "40",
            DetailLevel.Full => "80",
            _ => "40",
        };
        minHeight = $"min-height: {minHeight}px;";
    }

    @if (Detail == DetailLevel.SearchRow) {
        <MudStack Row="true" Justify="Justify.FlexStart" Class="flex-1" Style="height: 6vh;">
            <MudStack Justify="Justify.Center" Class="flex-shrink-0">
                <MudPaper Outlined="true" Style="height: 100%; aspect-ratio: 1 / 1; overflow: hidden;">
                    <MudImage Src="@Item.BaseImageLink" Style="width: 100%; height: 100%; object-fit: contain;" />
                </MudPaper>
            </MudStack>

            <MudStack Justify="Justify.SpaceAround" AlignItems="AlignItems.Start" Spacing="0" Class="flex-1"
                      Style="min-width: 0;">
                <MudText Typo="Typo.body1" Class="ellipsis"
                         Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 16vw; min-width: 0; line-height: 1.15;">
                    @Item.Name
                </MudText>

                @* Type badge under the name, colour-coded so a mixed list can be
                   scanned without reading every row. Each type gets its own
                   hue: items amber, quests blue, maps green.

                   Sized inline rather than via a style block: MudChip's
                   stylesheet sets margin:4px and a fixed height:24px, and
                   together those overran the row's fixed 6vh and clipped
                   the name. An inline style outranks a class rule, so this
                   needs no !important and no extra css. *@
                <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Size="Size.Small"
                         Icon="@Icons.Material.Outlined.Inventory2"
                         Style="height:18px;min-height:18px;margin:1px 0 0 0;font-size:11px;">
                    @Localizer["ResultTypeItem"]
                </MudChip>
            </MudStack>
        </MudStack>
    }

    @if (Detail == DetailLevel.OverlayRow) {
        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="@minHeight">
            <!--Left side of the search result item-->
            <MudStack Row="true" Justify="Justify.FlexStart" Class="flex-1" Style="min-width: 0;">
                <MudPaper Style="width: 48px; height: 48px; min-width: 48px;" Outlined="true">
                    <MudImage Src="@Item.BaseImageLink" Style="width: 100%; height: 100%; object-fit: contain;" />
                </MudPaper>

                <MudStack Spacing="0" Style="min-width: 0; overflow: hidden;">
                    <MudText Typo="Typo.subtitle1"
                             Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">
                        @Item.Name
                    </MudText>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Item.ShortName</MudText>
                        <MudIconButton Icon="@Constants.Icon.TarkovDev" Size="Size.Small" OnClick=@(() =>
                                       OpenURL($"https://tarkov.dev/item/{Item.Id}")) />
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" OnClick=@(() =>
                                       OpenURL(Item.WikiLink)) />
                    </MudStack>
                </MudStack>
            </MudStack>

            <!--Right side of the search result item-->
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudStack Spacing="0" AlignItems="AlignItems.End">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(Item.GetTaskRemaining().Item1 > 0 ? Color.Success : Color.Default)">
                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />
                        @Item.GetTaskRemaining().Item1.ToShortString()
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(Item.GetHideoutRemaining() > 0 ? Color.Success : Color.Default)">
                        <MudIcon Icon="@Icons.Material.Filled.House" Size="Size.Small" Class="mr-1" />
                        @Item.GetHideoutRemaining().ToShortString()
                    </MudChip>
                </MudStack>

                <MudDivider Vertical="true" FlexItem="true" />

                <MudStack Spacing="0" AlignItems="AlignItems.End" Style="min-width: 80px;">
                    <MudText Typo="Typo.subtitle2">@Item.Avg24HPrice.AsRubs()</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Item.GetAvg24hMarketPricePerSlot().AsRubs()/slot
                    </MudText>
                </MudStack>

                <MudDivider Vertical="true" FlexItem="true" />

                <MudStack Spacing="0" AlignItems="AlignItems.Center" Style="min-width: 50px;">
                    @{
                        var medBestTrader = Item.GetBestSellToTraderOffer();
                        var medTraderImage = medBestTrader?.Trader?.ImageLink;
                    }
                    <MudAvatar Image="@medTraderImage" Size="Size.Small" Square="true" Variant="Variant.Outlined" />
                    <MudText Typo="Typo.caption">@medBestTrader?.PriceRub.AsRubs()</MudText>
                </MudStack>
            </MudStack>
        </MudStack>
    }

    @if (Detail == DetailLevel.Full) {
        // Calculate Best Sell: Higher of Flea Market Sell Profit or Trader Buyback
        var fleaProfit = Item.GetAvg24hMarketSellProfit();
        var bestTraderSellOffer = Item.GetBestSellToTraderOffer();
        int bestTraderSellPrice = bestTraderSellOffer?.PriceRub ?? 0;
        bool isFleaBestSell = fleaProfit >= bestTraderSellPrice;
        int bestSellValue = Math.Max(fleaProfit, bestTraderSellPrice);

        // Calculate Best Buy: Lower of Flea 24h Avg or Trader Buy Offer
        var bestTraderBuyOffer = Item.GetBestBuyFromTraderOffer();
        int traderBuyPrice = bestTraderBuyOffer?.PriceRub ?? int.MaxValue;
        int fleaBuyPrice = Item.Avg24HPrice > 0 ? Item.Avg24HPrice.Value : int.MaxValue;
        bool isTraderBestBuy = traderBuyPrice < fleaBuyPrice;
        int bestBuyValue = Math.Min(fleaBuyPrice, traderBuyPrice);
        if (bestBuyValue == int.MaxValue) bestBuyValue = 0;

        // Fetch quest and hideout data
        var questReport = Item.GetQuestNeedReport();
        var hideoutBreakdown = Item.GetHideoutRequirementBreakdown();
        var acquisition = new Item.AcquisitionInfo(true, 4, false, 0
        @* Item.CraftsFor?.Count > 0, Item.CraftsFor?.Count ?? 0, *@
        @* Item.BartersFor?.Count > 0, Item.BartersFor?.Count ?? 0 *@
        );

        <MudText Typo="Typo.subtitle1" Class="font-weight-bold px-1 pb-1"
                 Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            @Item.Name
        </MudText>

        <div class="d-flex align-start pa-1" Style="gap: 8px;">
            <!-- Left Item Overview Card. Fixed square, so it never claims a
             proportional share of the row on wide layouts. -->
            <MudPaper Outlined="true" Class="d-flex align-center justify-center flex-shrink-0"
                      Style="width: 104px; height: 104px;">
                <MudImage Src="@Item.Image512PxLink" Alt="@Item.Name"
                          Style="width: 88px; height: 88px; object-fit: contain;" />
            </MudPaper>

            <!-- Right Content Area -->
            <div class="flex-grow-1" Style="min-width: 0;">
                <MudStack Spacing="1">
                    <!-- Market & Trader Pricing -->
                    <MudGrid Spacing="1">
                        <!-- Best Sell -->
                        <MudItem xs="6">
                            <MudPaper Outlined="true" Class="pa-1 px-2 d-flex align-center justify-space-between h-100"
                                      Style="background-color: var(--mud-palette-background-grey);">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    @if (isFleaBestSell) {
                                        <MudAvatar Color="Color.Info" Size="Size.Small" Square="true">
                                            <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                                        </MudAvatar>
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">Flea Market</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Best Profit</MudText>
                                        </div>
                                    } else {
                                        <MudAvatar Image="@bestTraderSellOffer?.Trader?.ImageLink" Size="Size.Small"
                                                   Square="true" />
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                @(bestTraderSellOffer?.Trader?.Name ?? "Trader")</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Trader Buyback</MudText>
                                            </div>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.body2" Color="Color.Success" Class="font-weight-bold">
                                        @bestSellValue.AsRubs()
                                    </MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- Best Buy -->
                            <MudItem xs="6">
                                <MudPaper Outlined="true" Class="pa-1 px-2 d-flex align-center justify-space-between h-100"
                                          Style="background-color: var(--mud-palette-background-grey);">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        @if (isTraderBestBuy) {
                                            <MudAvatar Image="@bestTraderBuyOffer?.Trader?.ImageLink" Size="Size.Small"
                                                       Square="true" />
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                    @(bestTraderBuyOffer?.Trader?.Name ?? "Trader")</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @(bestTraderBuyOffer?.MinTraderLevel != null ?
                                                    $"LL{bestTraderBuyOffer.MinTraderLevel}" : "Trader Buy")
                                                    </MudText>
                                                </div>
                                            }
                                else {
                                                <MudAvatar Color="Color.Info" Size="Size.Small" Square="true">
                                                    <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                                                </MudAvatar>
                                                <div>
                                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Flea Market</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Lowest Buy Price</MudText>
                                                </div>
                                            }
                                        </MudStack>
                                        <MudText Typo="Typo.body2" Color="Color.Warning" Class="font-weight-bold">
                                            @(bestBuyValue > 0 ? bestBuyValue.AsRubs() : "N/A")
                                        </MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <!-- Requirements & Usage -->
                            <MudPaper Outlined="true" Class="pa-2">
                                <div class="d-flex align-center flex-wrap" Style="gap: 4px;">
                                    <MudFlexWrap Spacing="1" Class="gap-1 flex-grow-1">
                                        <!-- Quest Chips -->
                                        <MudChip T="string" Icon="@Icons.Material.Filled.Checklist" Variant="Variant.Filled"
                                                 Color="@(questReport.GrandTotal > 0 ? Color.Primary : Color.Default)" Size="Size.Small">
                                            Quests: <b>@questReport.GrandTotal</b>
                                            (@questReport.ActiveNow/@questReport.AvailableNow)
                                        </MudChip>

                                        @if (questReport.FutureKnown > 0) {
                                            <MudChip T="string" Icon="@Icons.Material.Filled.Lock" Variant="Variant.Outlined"
                                                     Color="Color.Warning" Size="Size.Small">
                                                Locked: <b>@questReport.FutureKnown</b>@(questReport.UnlockLevel.HasValue ? $" (Lvl                                {questReport.UnlockLevel.Value})" : "")
                                            </MudChip>
                                        }

                                        @if (questReport.ConditionalUnknown > 0) {
                                            <MudChip T="string" Icon="@Icons.Material.Filled.HelpOutline" Variant="Variant.Outlined"
                                                     Color="Color.Default" Size="Size.Small">
                                                Conditional: <b>@questReport.ConditionalUnknown</b>
                                            </MudChip>
                                        }

                                        @if (questReport.FirTotal > 0) {
                                            <MudChip T="string" Icon="@Icons.Material.Filled.Verified" Variant="Variant.Outlined"
                                                     Color="Color.Secondary" Size="Size.Small">
                                                FIR Needed: <b>@questReport.FirTotal</b>
                                            </MudChip>
                                        }

                                        <!-- Hideout Chips -->
                                        <MudChip T="string" Icon="@Icons.Material.Filled.House" Variant="Variant.Filled"
                                                 Color="@(hideoutBreakdown.Total > 0 ? Color.Primary : Color.Default)" Size="Size.Small">
                                            Hideout: <b>@hideoutBreakdown.Total</b>@(hideoutBreakdown.HasFirNeed ? $" ({hideoutBreakdown.FoundInRaid} FIR)" : "")
                                        </MudChip>

                                        <!-- Acquisition Chips -->
                                        @if (acquisition.CanCraft) {
                                            <MudChip T="string" Icon="@Icons.Material.Filled.Build" Variant="Variant.Outlined"
                                                     Color="Color.Info" Size="Size.Small">
                                                Crafts (@acquisition.CraftRecipeCount)
                                            </MudChip>
                                        }

                                        @if (acquisition.CanBarter) {
                                            <MudChip T="string" Icon="@Icons.Material.Filled.SyncAlt" Variant="Variant.Outlined"
                                                     Color="Color.Info" Size="Size.Small">
                                                Barters (@acquisition.BarterOfferCount)
                                            </MudChip>
                                        }
                                    </MudFlexWrap>

                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Constants.Icon.TarkovDev" Size="Size.Small"
                                               OnClick="@(() => OpenURL($"https://tarkov.dev/item/{Item.Id}"))">
                                        Tarkov.dev
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                               StartIcon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                               OnClick="@(() => OpenURL(Item.WikiLink))">
                                        Wiki
                                    </MudButton>
                                </div>
                            </MudPaper>
                        </MudStack>
                    </div>
                </div>
            }

            @if (Detail == DetailLevel.Full && Item.Properties?.PropertiesType == "ItemPropertiesAmmo") {
                <MudDivider Vertical="false" DividerType="DividerType.Middle" Class="mx-0 my-2" />

                <MudStack Row="false">
                    <MudTable T="Item" Items="@Item.GetAmmoOfSameCaliber()" Dense="true" FixedHeader="true" Elevation="0"
                              Striped="true" Style="max-height: 300px; overflow-y: auto;"
                              RowStyleFunc="@((ctx, _) => ctx.Id == Item.Id ? "background: #FFFF8040;" : "")">
                        <HeaderContent>
                            <MudTh Style="">Name</MudTh>
                            <MudTh Style="text-align:right">
                                <MudTableSortLabel SortBy="new Func<Item, object>(x => x.Avg24HPrice)">Price</MudTableSortLabel>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTableSortLabel SortBy="new Func<Item, object>(x => x.Properties?.Damage)">Damage
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh Style="text-align:right">
                                <MudTableSortLabel InitialDirection="SortDirection.Ascending"
                                                   SortBy="new Func<Item, object>(x=>x.Properties?.PenetrationPower)">Pen</MudTableSortLabel>
                            </MudTh>
                            <MudTh Style="text-align:right">Frag %</MudTh>
                            <MudTh Style="text-align:center">Armor Pen</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @if (context.Properties?.PropertiesType != "ItemPropertiesAmmo") return;
                            <MudTd Class="my-0 py-0">
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudImage Src="@context.BaseImageLink" Style="width: 32px; height: 32px;" />
                                    <MudText Style="">@context.ShortName</MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd Style="text-align:right">@context.Avg24HPrice.AsRubs()</MudTd>
                            <MudTd Style="text-align:right">@context.Properties!.Damage</MudTd>
                            <MudTd Style="text-align:right">@context.Properties!.PenetrationPower</MudTd>
                            <MudTd Style="text-align:right">@((int)((context.Properties!.FragmentationChance ?? 0m) * 100m))%
                            </MudTd>
                            <MudTd Style="text-align:center">
                                @for (int _i = 0; _i < 6; _i++) {
                                    int i = _i;
                                    decimal value = Math.Clamp((context.Properties!.PenetrationPower ?? 0m) / 10m - i, 0, 1);
                                    int hue = (int)(value * 120m);
                                    string style = $"background-color: hsl({hue},100%,40%);";
                                    <MudAvatar Size="Size.Small" Square="true" Variant="Variant.Outlined" Style="@style">
                                        @(i + 1)
                                    </MudAvatar>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudStack>
            }
        </MudPaper>

@code {
    /// <summary>Which context to render this item in.</summary>
    [Parameter]
    public DetailLevel Detail { get; set; }

    [Parameter]
    public required Item Item { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Inject]
    public LocalizationService Localizer { get; set; } = null!;

    private void HandleClick() {
        OnClick.InvokeAsync();
    }

    private void OpenURL(string? url) {
        if (string.IsNullOrEmpty(url)) return;
        var psi = new ProcessStartInfo {
            FileName = url,
            UseShellExecute = true,
        };
        Process.Start(psi);
    }
}
