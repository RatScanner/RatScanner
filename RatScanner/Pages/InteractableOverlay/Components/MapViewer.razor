@using RatScanner.TarkovDev.Json
@using Microsoft.JSInterop
@using System.Globalization
@implements IDisposable

@*
    A zoomable, draggable map.

    Rendered inline by the main UI below the selected map's info card, and
    full-screen by the interactable overlay. Inline mode sizes the map to fill
    its container, so the map data and markers are shared between the two.
*@

<div class="@(Inline ? "map-viewer map-viewer-inline" : "map-viewer map-viewer-full")">
    @if (!Inline) {
        <div class="map-viewer-header">
            <MudPaper Class="pa-2">
                <MudText Typo="Typo.h5">@Map.Name</MudText>
                <MudText Typo="Typo.caption" Class="mt-1">@Localizer["MapViewerHint"]</MudText>
            </MudPaper>
        </div>
        <div class="map-viewer-close">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Large" Color="Color.Error" OnClick="OnClose" />
        </div>
    } else if (OnExpand.HasDelegate) {
        @* Sits outside the pan surface on purpose. The container below handles
           pointerdown to start a drag, and a button inside it would be dragged
           along with the map on the first press. *@
        <div class="map-viewer-expand">
            <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" Size="Size.Small" Color="Color.Primary"
                           OnClick="@(() => OnExpand.InvokeAsync())" />
        </div>
    }

    @* The map fills a box of known size, and the image is scaled inside it.
         Using a definite height here (rather than a viewport unit) is what lets
         this work both inline and full-screen. *@
    <div class="map-viewer-container" @ref="_container" @onwheel="HandleWheel" @onpointerdown="HandlePointerDown"
         @onpointermove="HandlePointerMove" @onpointerup="HandlePointerUp" @onpointercancel="HandlePointerUp"
         @onpointerleave="HandlePointerUp">
        @if (!HasSvg) {
            <div class="map-viewer-missing">
                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Large" />
                <MudText Typo="Typo.body2" Class="mt-1">@Localizer["MapNoDataHint"]</MudText>
            </div>
        } else {
            <div class="map-transform-wrapper @(_isDragging ? "dragging" : "")"
                 style="--map-x: @(_translateX.ToString(CultureInfo.InvariantCulture))px; --map-y: @(_translateY.ToString(CultureInfo.InvariantCulture))px; --map-scale: @(_scale.ToString(CultureInfo.InvariantCulture));">
                @* Aspect ratio taken from the map's own viewBox, so the canvas
                   matches the artwork and percentages land in the right place. *@
                <div class="map-canvas" style="aspect-ratio: @CanvasAspectRatio">
                    @* Inlined rather than an <img>: a SVG in an img is rasterized
                       once at display size, so scaling it up magnifies those pixels
                       and the map goes blurry. Inline markup stays vector. *@
                    @((MarkupString)(SvgContent ?? ""))

                    @* Area shapes. Drawn under the markers so an icon is never
                       hidden by the zone it belongs to. The layer shares the
                       canvas box and uses a 0-100 viewBox, so the vertex
                       percentages feed straight into it without conversion. *@
                    @if (HasPolygons) {
                        <svg class="poi-shapes" viewBox="0 0 100 100" preserveAspectRatio="none">
                            @foreach (var poi in DisplayedPois!) {
                                if (poi.Points == null || poi.Points.Count < 3) continue;
                                <polygon points="@PointsAttribute(poi)" style="@ShapeStyle(poi)" />
                            }
                        </svg>
                    }

                    @* Markers. Positioned in percentages of the canvas, which
                       scales with the zoom, so they track the map when it moves. *@
                    @if (DisplayedPois is { Count: > 0 }) {
                        foreach (var poi in DisplayedPois) {
                            var isQuestObjective = !string.IsNullOrEmpty(poi.TaskId);
                            var cssClass = isQuestObjective
                                ? "poi poi-clickable"
                                : "poi";
                            <div class="@cssClass"
                                 style="left: @(poi.X.ToString(CultureInfo.InvariantCulture))%; top: @(poi.Y.ToString(CultureInfo.InvariantCulture))%;"
                                 @onpointerdown:stopPropagation="true" @onpointerdown:preventDefault="true"
                                 @onclick="@(() => HandlePoiClick(poi))">
                                <div class="poi-icon" style="@IconStyle(poi)">
                                    @if (!string.IsNullOrWhiteSpace(poi.IconSvg)) {
                                        @((MarkupString)poi.IconSvg)
                                    } else {
                                        <span class="poi-dot"></span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(poi.Name)) {
                                    <div class="poi-name" style="@NameStyle(poi)">@poi.Name</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Full-screen: fills the viewport. Inline: a fixed-height block in the page
       flow, directly under the map's info card. */
    .map-viewer-full {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0, 0, 0, 0.95);
    }

    .map-viewer-inline {
        /* Size comes from the parent rather than the page flow, so the map
           fills the space left over instead of taking a fixed slice. A
           definite height here is what lets the percentage heights below
           (container, transform wrapper, svg) resolve all the way down.

           relative makes this the containing block for the absolutely
           positioned expand button. Without it the button would anchor to the
           window instead; map-viewer-full needs no such declaration because
           position: fixed already establishes one. */
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 120px;
    }

    .map-viewer-header {
        position: absolute;
        top: 20px;
        left: 20px;
        z-index: 10000;
        max-width: 400px;
    }

    .map-viewer-close {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 10000;
    }

    /* Absolute inside the .map-viewer wrapper rather than the pan surface, so
       the button does not move when the map is dragged. */
    .map-viewer-expand {
        position: absolute;
        top: 6px;
        right: 6px;
        z-index: 10;
    }

    .map-viewer-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
        /* Stop the browser from claiming pointer moves for scrolling or text
           selection, which would otherwise compete with dragging. */
        touch-action: none;
    }

    .map-viewer-full .map-viewer-container {
        height: 100%;
    }

    .map-viewer-inline .map-viewer-container {
        /* flex:1 fills the inline viewer; min-height:0 lets it shrink. The
           height property is left to the flex parent. */
        flex: 1;
        min-height: 0;
        border-radius: 4px;
    }

    .map-viewer-container:active,
    .map-transform-wrapper.dragging {
        cursor: grabbing;
    }

    .map-viewer-missing {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 16px;
        text-align: center;
        color: var(--mud-palette-text-secondary);
    }

    /* Centred on the container, then dragged by the inline transform.
       Absolutely positioned so it does not affect layout, and a flex box so the
       canvas inside it can be centred and clipped to the frame. */
    .map-transform-wrapper {
        position: absolute;
        top: 50%;
        left: 50%;
        width: calc(100% * var(--map-scale, 1));
        height: calc(100% * var(--map-scale, 1));
        display: flex;
        align-items: center;
        justify-content: center;
        /* Only translate here. Zoom deliberately does NOT use transform: scale,
           because that (together with the layer promotion from will-change)
           makes the browser rasterize the SVG into a texture once and scale
           that bitmap, which is what made the map blurry. */
        transform: translate(var(--map-x, 0px), var(--map-y, 0px)) translate(-50%, -50%);
        /* Promote to its own layer so dragging is a compositor-only operation
           and does not repaint the large SVG each frame. Safe now that the
           transform is translate-only. */
        will-change: transform;
    }

    /* Holds the svg and the markers together, so markers can be positioned in
       percentages of the artwork rather than of the viewport.

       The box is sized to the artwork's own aspect ratio. Sizing it to the frame
       instead made the canvas taller than the letterboxed map, so every marker's
       top percentage resolved against the wrong box and they bunched up around
       the middle of the frame. */
    .map-canvas {
        position: relative;
        /* Width drives the height via aspect-ratio, so the box is exactly the
           artwork's shape and percentages land on it correctly. A tall map may
           overflow the frame vertically; the container clips it and dragging
           brings the rest into view. */
        width: 100%;
        height: auto;
        max-width: 100%;
    }

    /* The canvas is exactly the artwork's size, so the svg fills it with no
       letterboxing left over for the markers to drift into. */
    .map-canvas>svg {
        display: block;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    /* A point of interest: icon with the name underneath.

       The position refers to the icon, not to the whole marker, so the box is
       anchored by its top-left corner and only shifted left by half its own
       width. Centring the whole box would let a long or wrapped label push the
       icon above the spot it marks. The label then hangs below the icon,
       outside the anchored area, without affecting where the icon sits. */
    .poi {
        position: absolute;
        transform: translate(-50%, -50%);
        pointer-events: auto;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* The icon is the anchor, so it must not be squashed by a tall label. */
        align-self: flex-start;
    }

    /* Boxed background so the icon reads against any part of the map. The
       default is overridden per marker via POI.IconColor, so each kind of
       point reads differently at a glance. */
    .poi-icon {
        background: var(--poi-icon-color, rgba(255, 152, 0, 0.9));
        border-radius: 50%;
        padding: 6px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
        border: 2px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* The icon's own svg. Fixed size so different icons line up with each other. */
    .poi-icon>svg {
        width: 20px;
        height: 20px;
        display: block;
    }

    /* Fallback when a POI has no icon. */
    .poi-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #fff;
        display: block;
    }

    .poi-name {
        background: rgba(0, 0, 0, 0.8);
        padding: 2px 6px;
        border-radius: 4px;
        margin-top: 4px;
        font-size: 12px;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    }

    .poi:hover .poi-icon {
        background: var(--poi-icon-color-hover, rgba(255, 193, 7, 1));
        box-shadow: 0 0 30px var(--poi-icon-color-hover, rgba(255, 193, 7, 1));
    }

    /* An objective marker that can be clicked to open its quest. The cursor is
       the only cue: the markers carry no other affordance, and the shapes layer
       below has pointer-events off, so only the icon itself is a target. */
    .poi-clickable {
        cursor: pointer;
    }

    /* The polygon layer. Stretched over the whole canvas box with a 0-100
       viewBox, which is why it needs no positioning of its own, and it must
       not eat pointer events meant for dragging the map. */
    .poi-shapes {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 90;
        overflow: visible;
    }
</style>

@code {
    [Parameter]
    public required Map Map { get; set; }

    /// <summary>
    /// Whether to render in the page flow under the map's info card instead of
    /// covering the screen. The main UI uses inline; the overlay uses full.
    /// </summary>
    [Parameter]
    public bool Inline { get; set; }

    /// <summary>
    /// Points of interest to draw on the map, e.g. extractions, traders, scav
    /// spawns or quest objectives. Coordinates are percentages of the map, so
    /// they stay put across zoom and pan.
    /// </summary>
    [Parameter]
    public List<POI>? Pois { get; set; }

    /// <summary>
    /// Subset of <see cref="Pois"/> to centre the view on when the map opens,
    /// or null to show the map as it comes. Used to bring a quest objective's
    /// area into view instead of leaving it somewhere off in a corner.
    ///
    /// A subset rather than all of <see cref="Pois"/> on purpose: the objective
    /// markers usually sit alongside extraction and door overlays, and
    /// centring on those too would average the view away from the objective.
    /// </summary>
    [Parameter]
    public List<POI>? FocusPois { get; set; }

    /// <summary>
    /// Raised when a marker carrying a task id is clicked. Left unwired the
    /// markers are still drawn, but clicking one does nothing, so a map that
    /// has objectives on it but nowhere to send the click stays inert rather
    /// than opening something unexpected.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnPoiTaskClick { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Raised when the inline viewer is expanded to fill the screen. Left
    /// unwired the button is not rendered, since there would be nothing to do.
    /// </summary>
    [Parameter]
    public EventCallback OnExpand { get; set; }

    [Inject]
    public LocalizationService Localizer { get; set; } = null!;

    private const double MinScale = 0.3;
    private const double MaxScale = 5.0;

    private double _scale = 1.0;
    private double _translateX = 0;
    private double _translateY = 0;
    private bool _isDragging = false;
    private double _lastMouseX = 0;
    private double _lastMouseY = 0;

    /// <summary>
    /// The map that is currently shown. Used to detect a map change so the view
    /// can be reset.
    /// </summary>
    private Map? _shownMap;

    /// <summary>
    /// The focus set the view was last centred on, so a new one is only applied
    /// when the caller actually changed it rather than on every render.
    /// </summary>
    private List<POI>? _shownFocusPois;

    /// <summary>
    /// The caller's markers plus the current player marker when this map is the
    /// active raid map. Kept local so every viewer gets the same behaviour.
    /// </summary>
    private List<POI>? DisplayedPois { get; set; }

    /// <summary>
    /// Whether a pan is still owed. Set when the focus changes and cleared once
    /// the container has been measured.
    /// </summary>
    private bool _focusPending;

    /// <summary>
    /// Whether interactive SVG data exists for this map. Without it there is
    /// nothing to draw, so a message replaces the map rather than a blank box.
    /// </summary>
    private bool HasSvg => !string.IsNullOrEmpty(MapDataLoader.GetMapSvgUrl(Map.Id));

    /// <summary>
    /// The map's SVG markup, inlined so zooming stays sharp. Null when the map
    /// has no data or the fetch failed, in which case the container shows the
    /// missing-data message instead.
    /// </summary>
    private string? SvgContent => MapDataLoader.GetMapSvgContent(Map.Id);

    /// <summary>
    /// The map's own aspect ratio, read from the svg's viewBox. The canvas uses
    /// it so percentage-positioned markers land on the artwork rather than on
    /// the edges of the frame.
    /// </summary>
    private string CanvasAspectRatio {
        get {
            if (!MapDataLoader.TryGetSvgViewBoxSize(Map.Id, out var w, out var h) || w <= 0 || h <= 0) {
                return "auto";
            }

            return $"{w.ToString(CultureInfo.InvariantCulture)} / {h.ToString(CultureInfo.InvariantCulture)}";
        }
    }

    /// <summary>
    /// Inline style for a POI's name label. The color is optional, so fall back
    /// to the theme's text color when the POI does not specify one.
    /// </summary>
    private static string NameStyle(POI poi) {
        var color = string.IsNullOrWhiteSpace(poi.NameColor) ? "var(--mud-palette-text-primary)" : poi.NameColor;
        return $"color: {color};";
    }

    /// <summary>
    /// Inline style for a POI's icon disc. Each kind of marker gets its own
    /// color so overlays are told apart on the map without reading the labels.
    /// The hover color is the same hue brightened, so the hover state keeps
    /// the marker's identity rather than always going yellow.
    /// </summary>
    private static string IconStyle(POI poi) {
        var style = string.Empty;

        if (!string.IsNullOrWhiteSpace(poi.IconColor)) {
            var hover = string.IsNullOrWhiteSpace(poi.IconColorHover) ? poi.IconColor : poi.IconColorHover;
            style += $"--poi-icon-color: {poi.IconColor};--poi-icon-color-hover: {hover};";
        }

        // Rotating the disc is safe because it is a circle, and it carries the
        // icon with it. Only directional markers set this.
        if (poi.RotationDegrees != 0) {
            style += $"transform: rotate({poi.RotationDegrees.ToString(CultureInfo.InvariantCulture)}deg);";
        }

        return style;
    }

    /// <summary>
    /// Whether any POI carries a polygon. Avoids emitting the SVG layer at all
    /// for the common all-point case.
    /// </summary>
    private bool HasPolygons => DisplayedPois is { Count: > 0 } && DisplayedPois.Any(p => p.Points is { Count: >= 3 });

    private List<POI>? BuildDisplayedPois() {
        var displayed = Pois?.ToList() ?? [];
        displayed.AddRange(Map.GetQuestObjectivePois(RatScanner.TaskExtensions.GetAvailableTasksForMap(Map.Id)));

        var tracker = RatScannerMain.Instance.PlayerPosition;
        var position = tracker?.CurrentPosition;
        var rotation = tracker?.CurrentRotation;

        if (position is not null && rotation is not null && EftRaidLifecycle.CurrentMapId == Map.Id &&
            Map.GetPlayerPositionPoi(position, rotation.Value) is { } player) {
            displayed.Add(player);
        }

        return displayed.Count > 0 ? displayed : null;
    }

    /// <summary>
    /// The polygon vertices as an SVG "points" list. Culture is forced so a
    /// machine set to a comma-decimal locale does not emit "1,5" and split the
    /// number in two.
    /// </summary>
    private static string PointsAttribute(POI poi) {
        return string.Join(" ", poi.Points.Select(p =>
            $"{p.X.ToString(CultureInfo.InvariantCulture)},{p.Y.ToString(CultureInfo.InvariantCulture)}"));
    }

    /// <summary>
    /// Inline style for a POI's polygon. Reuses the icon colors so a marker and
    /// the area around it are recognisably the same thing, and keeps the stroke
    /// at a constant on-screen weight via a non-scaling stroke.
    /// </summary>
    private static string ShapeStyle(POI poi) {
        var color = string.IsNullOrWhiteSpace(poi.IconColor) ? "rgba(255, 152, 0, 0.9)" : poi.IconColor;
        var width = poi.StrokeWidth > 0 ? poi.StrokeWidth : 2;
        var style =
            $"fill: {(poi.FillPolygon ? color : "none")};" +
            $"stroke: {color};" +
            $"stroke-width: {width.ToString(CultureInfo.InvariantCulture)};" +
            "stroke-linejoin: round;" +
            "vector-effect: non-scaling-stroke;";

        // A filled polygon at full opacity hides the map under it, so only the
        // outline is drawn at full strength unless a fill was asked for.
        if (poi.FillPolygon) {
            style += "fill-opacity: 0.25;";
        }

        return style;
    }

    protected override void OnParametersSet() {
        DisplayedPois = BuildDisplayedPois();

        // Reset the view when a different map is shown, so a previous map's pan
        // and zoom do not carry over.
        var mapChanged = !ReferenceEquals(_shownMap, Map);
        if (mapChanged) {
            _shownMap = Map;
            _scale = 1.0;
            _translateX = 0;
            _translateY = 0;
            _isDragging = false;
        }

        // Queue the pan rather than doing it here. Centring needs the container's
        // measured size, which does not exist until after the first render, and
        // it must not fight the user's own panning afterwards, so it is applied
        // once when the next viewport measurement arrives.
        //
        // Re-queued on a map change too: the reset above wipes the pan, and the
        // focus list can legitimately be the same instance as before.
        if (mapChanged || !ReferenceEquals(_shownFocusPois, FocusPois)) {
            _shownFocusPois = FocusPois;
            _focusPending = true;
        }
    }

    protected override void OnInitialized() {
        RatScannerMain.Instance.PlayerPositionChanged += OnPlayerPositionChanged;
    }

    private void OnPlayerPositionChanged() {
        _ = InvokeAsync(() => {
            DisplayedPois = BuildDisplayedPois();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Pans so the focused markers sit in the middle of the container, without
    /// changing the zoom level.
    ///
    /// The pan has to account for the artwork being letterboxed inside the
    /// canvas. A marker at 50% height is at the canvas's centre, but the canvas
    /// itself may be shorter than the wrapper, so the vertical offset is measured
    /// against the canvas height rather than the wrapper height. Getting this
    /// wrong is invisible on a square map and visibly off-centre on a wide one.
    /// </summary>
    private void ApplyFocus() {
        var focus = FocusPois;
        if (focus == null || focus.Count == 0 || !_viewport.IsValid) return;

        // Centre on the middle of the group rather than on the first marker, so
        // an objective spread over several zones ends up framed as a whole.
        double percentX, percentY;
        if (HasPolygons && focus.Any(p => p.Points is { Count: >= 3 })) {
            // For a zone, the middle of its shape reads better than the middle of
            // a set of points that may be skewed by one distant vertex.
            var points = focus.SelectMany(p => p.Points ?? []).ToList();
            percentX = points.Average(p => p.X);
            percentY = points.Average(p => p.Y);
        } else {
            percentX = focus.Average(p => p.X);
            percentY = focus.Average(p => p.Y);
        }

        var wrapperWidth = _viewport.Width * _scale;
        var wrapperHeight = _viewport.Height * _scale;

        // The canvas is as wide as the wrapper and takes its height from the
        // artwork's aspect ratio, so it can be shorter than the wrapper. That
        // leftover is split evenly above and below by the flex centring.
        var canvasHeight = MapDataLoader.TryGetSvgViewBoxSize(Map.Id, out var w, out var h) && w > 0 && h > 0
            ? wrapperWidth / (w / h)
            : wrapperHeight;

        // Offset of the target from the wrapper's centre, which is where the
        // wrapper is anchored. Shifting by its negative moves it onto the centre.
        var offsetX = (percentX / 100 - 0.5) * wrapperWidth;
        var offsetY = (percentY / 100 - 0.5) * canvasHeight;

        _translateX = -offsetX;
        _translateY = -offsetY;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        // The cursor-anchored zoom needs to know where the container sits on
        // screen. Refreshed after every render (this does not itself trigger a
        // render) so a resized or moved window keeps zooming in the right spot.
        await RefreshViewportAsync();

        // Centring can only happen once the container has a measured size. The
        // resulting pan changes the rendered transform, so re-render to apply it.
        if (_focusPending && _viewport.IsValid) {
            _focusPending = false;
            ApplyFocus();
            StateHasChanged();
        }
    }

    /// <summary>
    /// The map's container, used to turn the cursor's screen position into a
    /// position within the map.
    /// </summary>
    private ElementReference _container;

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;

    /// <summary>
    /// The container's last known position and size on screen. Refreshed whenever
    /// the map is shown or resized, so a wheel event does not have to await a
    /// round trip to JS before it can be handled.
    /// </summary>
    private MapViewport _viewport;

    private readonly record struct MapViewport(double Left, double Top, double Width, double Height) {
        /// <summary>
        /// Whether the viewport has a usable size, so the cursor's position can be
        /// measured against it.
        /// </summary>
        public bool IsValid => Width > 0 && Height > 0;

        /// <summary>
        /// Horizontal centre of the container. The zoom anchor is measured from
        /// here, not from <see cref="Left"/>.
        /// </summary>
        public double CentreX => Left + Width / 2;

        /// <summary>Vertical centre of the container. See <see cref="CentreX"/>.</summary>
        public double CentreY => Top + Height / 2;
    }

    /// <summary>Zoom multiplier for one wheel notch. See <see cref="ZoomStep"/>.</summary>
    private const double ZoomFactor = 1.2;

    /// <summary>
    /// One wheel notch, as a power of <see cref="ZoomFactor"/>.
    ///
    /// Raising the factor to a power rather than using it directly is what makes
    /// the zoom feel exponential: 1.2^1.35 is about 1.28x per notch, and the
    /// curve stays smooth rather than stepping by a fixed amount.
    /// </summary>
    private const double ZoomStep = 1.35;

    private void HandleWheel(WheelEventArgs e) {
        // Let the page scroll when the map is already at its zoom limit,
        // otherwise the wheel event is swallowed by the map.
        var zoomingIn = e.DeltaY < 0;
        if ((zoomingIn && _scale >= MaxScale) || (!zoomingIn && _scale <= MinScale)) return;

        // Negated exponent when zooming out, so one branch covers both
        // directions. Math.Pow cannot take a negative base, hence the
        // separate signs rather than Math.Pow(ZoomFactor, -ZoomStep).
        var previous = _scale;
        _scale = Math.Clamp(_scale * Math.Pow(ZoomFactor, zoomingIn ? ZoomStep : -ZoomStep), MinScale, MaxScale);
        if (_scale == previous || !_viewport.IsValid) return;

        // Keep the point under the cursor still.
        //
        // The wrapper is laid out at container size * scale, positioned with
        // `top/left: 50%` (the container's centre) and then offset by
        // translate(--map-x, --map-y). So a point on screen is measured from the
        // container's CENTRE, not its top-left corner.
        //
        // Zooming grows the wrapper about that same centre, which moves a point
        // at distance d from the centre out to d * ratio. To keep the point
        // under the cursor, translate has to move back by exactly the difference:
        //
        // offset = cursor - centre - translate (distance from wrapper centre)
        // newTranslate = cursor - centre - offset*ratio
        //
        // Dropping the centre term (using Left/Top instead) biases every step by
        // centre*(1 - ratio), which makes the map creep away from the cursor on
        // every wheel tick.
        var ratio = _scale / previous;
        var offsetX = e.ClientX - _viewport.CentreX - _translateX;
        var offsetY = e.ClientY - _viewport.CentreY - _translateY;

        _translateX = e.ClientX - _viewport.CentreX - offsetX * ratio;
        _translateY = e.ClientY - _viewport.CentreY - offsetY * ratio;
    }

    private async Task RefreshViewportAsync() {
        try {
            var rect = await JSRuntime.InvokeAsync<MapRect?>("ratScanner.getBoundingRect", _container);

            if (rect != null) {
                _viewport = new MapViewport(rect.Left, rect.Top, rect.Width, rect.Height);
            }
        } catch (Exception e) {
            Logger.LogWarning($"Could not read map container bounds: {e.Message}");
        }
    }

    private sealed class MapRect {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private void HandlePointerDown(PointerEventArgs e) {
        _isDragging = true;
        _lastMouseX = e.ClientX;
        _lastMouseY = e.ClientY;
    }

    private void HandlePointerMove(PointerEventArgs e) {
        if (!_isDragging) return;

        _translateX += e.ClientX - _lastMouseX;
        _translateY += e.ClientY - _lastMouseY;

        _lastMouseX = e.ClientX;
        _lastMouseY = e.ClientY;
    }

    private void HandlePointerUp(PointerEventArgs e) {
        _isDragging = false;
    }

    /// <summary>
    /// Forwards a click on a marker, but only for markers that name a task.
    /// Anything else (an extract, a door, the player) is decoration, so the
    /// click is ignored and the map is left where it is.
    /// </summary>
    private Task HandlePoiClick(POI poi) {
        if (string.IsNullOrEmpty(poi.TaskId)) {
            return Task.CompletedTask;
        }

        var task = TarkovDevAPI.GetTasks().FirstOrDefault(candidate => candidate.Id == poi.TaskId);
        if (task == null) return Task.CompletedTask;

        RatScannerMain.Instance.SelectedResults.Enqueue(
            new RatScanner.Pages.InteractableOverlay.Services.SearchResult(task, 0));

        return OnPoiTaskClick.HasDelegate
            ? OnPoiTaskClick.InvokeAsync(poi.TaskId)
            : Task.CompletedTask;
    }

    public void Dispose() {
        RatScannerMain.Instance.PlayerPositionChanged -= OnPlayerPositionChanged;
    }
}
