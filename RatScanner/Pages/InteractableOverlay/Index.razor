@page "/interactableOverlay"
@using RatScanner.Scan
@using RatScanner.TarkovDev.Json
@using Task = System.Threading.Tasks.Task;
@using RatScanner.View;
@using Color = MudBlazor.Color
@using System.Diagnostics;
@using RatScanner.Pages.InteractableOverlay.Services;
@using RatScanner.Pages.InteractableOverlay.Components;
@using SearchResult = RatScanner.Pages.InteractableOverlay.Services.SearchResult;
@using RatScanner.Pages.App.Components
@inject MenuVM MenuVM
@inject RatScanner.VirtualScreenOffset VirtualScreenOffset
@inject SettingsVM SettingsVM;
@inject IJSRuntime JSRuntime;
@implements IDisposable

<div id="click-away-background" style="position: absolute; width: 100%; height: 100%;"
     onmousedown="if (event.target == this) DotNet.invokeMethodAsync('RatScanner', 'JSHideOverlay')"></div>
<div style="width: 100%; height: 100%;">
    <div style="position: relative; top: 20%; pointer-events: none;">
        <div class="d-flex align-content-center justify-center">
            <div style="width: 40vw; pointer-events: auto;">
                <MudPaper>
                    <MudTextField @ref="_searchTextField" T="string" Variant="Variant.Outlined"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="20"
                                  OnDebounceIntervalElapsed="ExecuteSearch" @bind-Value="@_searchText">
                    </MudTextField>
                </MudPaper>

                <MudStack Spacing="2" Class="py-2">
                    @for (int _i = 0; _i < _searchResults.Count(); _i++) {
                        int i = _i;
                        SearchResult searchResult = _searchResults.ElementAt(i);

                        @if (searchResult.Data is Item item) {
                            <ItemSearchResult Item="@item"
                                              Detail="@(i == _selectedResultIndex ? DetailLevel.Full : DetailLevel.OverlayRow)"
                                              OnClick="@(() => SelectResult(i))" />
                        } else if (searchResult.Data is TarkovTask task) {
                            <TaskSearchResult Task="@task"
                                              Detail="@(i == _selectedResultIndex ? DetailLevel.OverlayExpanded : DetailLevel.OverlayRow)"
                                              OnMapClick="@((tuple) => OpenMapForObjective(tuple.task, tuple.objective))"
                                              OnClick="@(() => SelectResult(i))" />
                        } else if (searchResult.Data is Map map) {
                            @* OverlayRow rather than the default SearchRow, which is
                               sized for the main UI list. A map row opens the viewer
                               directly, so it has nothing to expand into when
                               selected, unlike an item or a quest. *@
                            <MapSearchResult Map="@map" Detail="DetailLevel.OverlayRow"
                                             OnMapClick="@(() => OpenMapViewer(map))" />
                        }
                    }
                </MudStack>
            </div>
        </div>
    </div>
</div>

@* The full-screen map viewer, opened from a map result or a quest objective.
   Centred on the objective's zones when it was opened from one. *@
@if (_selectedMap != null) {
    <MapViewer Map="@_selectedMap" Pois="@_selectedPois" FocusPois="@_selectedPois" OnClose="@CloseMapViewer" />
}

@code {
    private static MudTextField<string> _searchTextField { get; set; } = null!;
    private string _searchText { get; set; } = "";
    private IEnumerable<SearchResult> _searchResults { get; set; } = new List<SearchResult>();
    private int _selectedResultIndex { get; set; } = 0;

    // Map viewer state
    private Map? _selectedMap = null;
    private List<POI>? _selectedPois = null;

    /// <summary>Bumped per search so one that finishes late discards its result.</summary>
    private int _searchGeneration;

    private async void ExecuteSearch(string value) {
        var sanitizedValue = SearchService.SanitizeSearch(value);
        var generation = ++_searchGeneration;

        var results = Enumerable.Empty<SearchResult>();
        results = results.Concat(await SearchService.SearchItemsAsync(sanitizedValue));
        results = results.Concat(await SearchService.SearchTasksAsync(sanitizedValue));
        results = results.Concat(await SearchService.SearchMapsAsync(sanitizedValue));
        results = results.Where(result => result != null && result.Data != null);
        results = results.OrderBy(result => result.Score).Take(4);

        if (generation != _searchGeneration) return;

        _searchResults = results;
        _selectedResultIndex = 0;

        // The debounce fires from a timer, not the render loop, so assigning
        // the results does not schedule a repaint on its own.
        StateHasChanged();
    }

    private void SelectResult(int index) {
        _selectedResultIndex = index;
        StateHasChanged();
    }

    private void OpenMapForObjective(TarkovTask task, TaskObjective objective) {
        // Only objectives that name a place can be shown on a map; the caller
        // hides the button otherwise.
        if (objective?.Zones == null || objective.Zones.Count == 0) return;

        // Zones are per-map. The first one decides which map to open, so an
        // objective spanning several maps starts on the one it lists first.
        var mapId = objective.Zones
            .Select(z => z?.Map)
            .FirstOrDefault(m => !string.IsNullOrEmpty(m));
        if (mapId == null) return;

        var map = TarkovDevAPI.GetMaps().FirstOrDefault(m => m.Id == mapId);
        if (map == null) return;

        // Every zone becomes a marker with its outline drawn as an area.
        _selectedPois = map.GetZonePois(objective.Zones);
        if (_selectedPois.Count == 0) return;

        _selectedMap = map;
        StateHasChanged();
    }

    private void OpenMapViewer(Map map) {
        _selectedMap = map;
        StateHasChanged();
    }

    private void CloseMapViewer() {
        _selectedMap = null;
        _selectedPois = null;
        StateHasChanged();
    }

    [JSInvokable]
    public static void JSHideOverlay() {
        BlazorUI.BlazorInteractableOverlay.HideOverlay();
    }

    [JSInvokable]
    public static void JSShowOverlay() {
        _searchTextField.FocusAsync();
        _searchTextField.SelectAsync();
    }

    protected override void OnInitialized() {
        MenuVM.PropertyChanged += PropertyChangeHandler;
        RatScannerMain.Instance.HotkeyManager.EscapePressed += OnEscapePressed;
        SettingsVM.GameModeChanged += OnGameModeChanged;
    }

    private void OnGameModeChanged(GameMode mode) {
        _selectedMap = _selectedMap is null
            ? null
            : TarkovDevAPI.GetMaps().FirstOrDefault(m => m.Id == _selectedMap.Id);
        _selectedPois = null;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Closes the map when Escape is pressed. Returns whether the key was
    /// consumed, so Escape only closes the whole overlay once no map is open.
    /// </summary>
    private bool OnEscapePressed() {
        if (_selectedMap == null) return false;

        _ = InvokeAsync(CloseMapViewer);
        return true;
    }

    private void PropertyChangeHandler(object? sender, EventArgs e) {
        _ = InvokeAsync(() => StateHasChanged());
    }

    public void Dispose() {
        MenuVM.PropertyChanged -= PropertyChangeHandler;
        RatScannerMain.Instance.HotkeyManager.EscapePressed -= OnEscapePressed;
        SettingsVM.GameModeChanged -= OnGameModeChanged;
    }
}
