@using System.Diagnostics
@inherits LayoutComponentBase
@layout MainLayout
@inject MenuVM MenuVM;
@inject IJSRuntime JSRuntime;
@inject LocalizationService Localizer;

<div class="app-container">
	<WindowChrome />
	<div class="app-body">
		@Body
	</div>
</div>

<style>
    .app-container {
        position: relative;
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        border: 2px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        overflow: hidden;
        background: #121212;
    }

    /* Flex items default to min-height:auto, so a plain page root would grow to
       its content height instead of scrolling. min-height:0 lets it shrink and
       hands the scrolling to this container for every page in the layout. */
    .app-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }
</style>
