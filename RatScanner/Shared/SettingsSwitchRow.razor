@*
	Convenience wrapper: a SettingsRow whose control is a MudSwitch.
*@

<SettingsRow Label="@Label" SubLabel="@SubLabel" Disabled="@Disabled">
    <MudSwitch T="bool" Checked="@Value" CheckedChanged="@OnValueChanged" Color="Color.Primary" Dense="true" />
</SettingsRow>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? SubLabel { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    private Task OnValueChanged(bool v) => ValueChanged.InvokeAsync(v);
}